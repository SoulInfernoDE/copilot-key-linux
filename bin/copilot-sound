#!/usr/bin/env bash
# Play one cue from the Copilot-key sound set.
#
# Usage: copilot-sound <cue-name> [volume 0.0-1.0]
#
# Cues live in $COPILOT_KEY_SOUND_DIR (default: ../sounds next to this script,
# or ~/.local/share/copilot-key/sounds after a normal install).
#
# Playback must never block the caller and never fail loudly, so the whole
# chain runs detached in the background. Every player is actually tried:
# a player being installed does not mean it can play this file (pw-play, for
# instance, refuses Ogg Vorbis in some builds), so we fall through until one
# of them really exits 0.
#
# Set COPILOT_KEY_DEBUG=1 to see which player was used and why others failed.

set -u

cue="${1:-}"
volume="${2:-1.0}"
[ -n "$cue" ] || { echo "usage: $(basename "$0") <cue> [volume]" >&2; exit 2; }

self_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
sound_dir="${COPILOT_KEY_SOUND_DIR:-}"
if [ -z "$sound_dir" ]; then
    for candidate in "$HOME/.local/share/copilot-key/sounds" "$self_dir/../sounds"; do
        [ -d "$candidate" ] && { sound_dir="$candidate"; break; }
    done
fi

debug() { [ "${COPILOT_KEY_DEBUG:-0}" = "1" ] && printf 'copilot-sound: %s\n' "$*" >&2; return 0; }

file=""
for ext in ogg wav; do
    [ -f "$sound_dir/$cue.$ext" ] && { file="$sound_dir/$cue.$ext"; break; }
done
if [ -z "$file" ]; then
    debug "cue '$cue' not found in '$sound_dir'"
    exit 0   # a missing cue is never fatal
fi

# PulseAudio expresses volume in 1/65536 steps, ffplay in percent.
pa_volume=$(awk -v v="$volume" 'BEGIN { x = v * 65536; if (x < 0) x = 0; if (x > 65536) x = 65536; printf "%d", x }')
pct_volume=$(awk -v v="$volume" 'BEGIN { x = v * 100; if (x < 0) x = 0; if (x > 100) x = 100; printf "%d", x }')

play_chain() {
    local rc

    if command -v paplay >/dev/null 2>&1; then
        paplay --volume="$pa_volume" "$file" >/dev/null 2>&1 && { debug "played via paplay"; return 0; }
        rc=$?; debug "paplay failed (rc=$rc)"
    fi

    if command -v pw-play >/dev/null 2>&1; then
        pw-play --volume="$volume" "$file" >/dev/null 2>&1 && { debug "played via pw-play"; return 0; }
        rc=$?; debug "pw-play failed (rc=$rc)"
    fi

    if command -v canberra-gtk-play >/dev/null 2>&1; then
        canberra-gtk-play -f "$file" >/dev/null 2>&1 && { debug "played via canberra-gtk-play"; return 0; }
        rc=$?; debug "canberra-gtk-play failed (rc=$rc)"
    fi

    if command -v ffplay >/dev/null 2>&1; then
        ffplay -nodisp -autoexit -loglevel quiet -volume "$pct_volume" "$file" >/dev/null 2>&1 \
            && { debug "played via ffplay"; return 0; }
        rc=$?; debug "ffplay failed (rc=$rc)"
    fi

    if command -v mpv >/dev/null 2>&1; then
        mpv --no-video --really-quiet --volume="$pct_volume" "$file" >/dev/null 2>&1 \
            && { debug "played via mpv"; return 0; }
        rc=$?; debug "mpv failed (rc=$rc)"
    fi

    if command -v gst-play-1.0 >/dev/null 2>&1; then
        gst-play-1.0 --quiet "$file" >/dev/null 2>&1 && { debug "played via gst-play-1.0"; return 0; }
        rc=$?; debug "gst-play-1.0 failed (rc=$rc)"
    fi

    # aplay only understands uncompressed audio.
    if [ "${file##*.}" = "wav" ] && command -v aplay >/dev/null 2>&1; then
        aplay -q "$file" >/dev/null 2>&1 && { debug "played via aplay"; return 0; }
        rc=$?; debug "aplay failed (rc=$rc)"
    fi

    debug "no working audio player found for $file"
    return 1
}

if [ "${COPILOT_KEY_DEBUG:-0}" = "1" ]; then
    # In debug mode wait for the result so the message is actually visible.
    echo "copilot-sound: file=$file volume=$volume" >&2
    play_chain
    exit $?
fi

play_chain &
exit 0
