        "single_press": "toggle_or_menu",  # toggle_or_menu | menu | toggle
        "menu_title": tr("menu_title"),
        "close_on_focus_loss": True,
        "menu_style": "radial",       # radial | list
        "menu_skin": "terracotta",    # a file name from skins/, without .toml
        "use_app_icons": False,       # real application icons instead of drawn ones
        "dim_opacity": 0.62,          # how far the desktop behind is dimmed
        "editor_theme": "auto",       # auto | dark | light
    },
    "actions": [
