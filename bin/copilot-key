#!/usr/bin/env python3
"""copilot-key - turn the Copilot button into a useful launcher.

One short press toggles the primary window (bring to front / minimise).
A quick double press opens a small chooser with all configured actions.
Every state change is confirmed by its own audio cue.

The key itself is delivered by keyd (see config/keyd-copilot.conf);
this script only reacts to being started.
"""

from __future__ import annotations

import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

APP = "copilot-key"
SELF_DIR = Path(__file__).resolve().parent
PROJECT_DIR = SELF_DIR.parent

# ---------------------------------------------------------------- paths ----

def runtime_dir() -> Path:
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/runtime-{os.getuid()}"
    d = Path(base) / APP
    d.mkdir(parents=True, exist_ok=True)
    return d


def config_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / APP / "config.toml"


def data_dirs() -> list[Path]:
    """Every place the installed data - sounds, skins - can live.

    A system-wide install puts it under /usr/local/share/copilot-key, a
    per-user one under ~/.local/share/copilot-key, and a git checkout keeps it
    next to the scripts. All three are searched, in that order of preference.
    """
    dirs: list[Path] = []
    env = os.environ.get("COPILOT_KEY_DATA_DIR")
    if env:
        dirs.append(Path(env))
    home = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    dirs.append(Path(home) / APP)
    raw = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    dirs += [Path(part) / APP for part in raw.split(":") if part]
    # A login shell does not always carry /usr/local/share in XDG_DATA_DIRS.
    dirs += [Path("/usr/local/share") / APP, Path("/usr/share") / APP]
    # Next to the scripts: a git checkout, or any prefix install.sh was
    # pointed at, where the data sits in <prefix>/share/copilot-key.
    dirs += [PROJECT_DIR, PROJECT_DIR / "share" / APP]
    return list(dict.fromkeys(dirs))


def sound_dir() -> Path:
    env = os.environ.get("COPILOT_KEY_SOUND_DIR")
    if env:
        return Path(env)
    for base in data_dirs():
        candidate = base / "sounds"
        if candidate.is_dir():
            return candidate
    return PROJECT_DIR / "sounds"


