            "command": "@configure",
            "icon": "gear",
            "window_class": "",
            "primary": False,
        },
    ],
}


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))  # deep copy
    path = config_path()
    if not path.is_file():
        return cfg
    try:
        import tomllib
    except ModuleNotFoundError:  # Python < 3.11
        warn(tr("warn_no_tomllib"))
        return cfg
    try:
        with path.open("rb") as fh:
            user = tomllib.load(fh)
    except Exception as exc:  # a broken config must never break the key
        warn(tr("warn_config_error", path=path, error=exc))
        return cfg
    cfg["general"].update(user.get("general", {}))
    if user.get("actions"):
        cfg["actions"] = user["actions"]
    return cfg


def warn(msg: str) -> None:
    print(f"{APP}: {msg}", file=sys.stderr)


# ------------------------------------------------------------ toml output --
# Both the editor and the menu's own edit mode write the configuration,
# so the comments live here - and the shipped templates in config/ are
# printed from the very same code (copilot-config --print-template),
# which keeps the two from drifting apart.

