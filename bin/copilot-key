def language() -> str:
    """UI language from the environment; English whenever there is no match."""
    override = os.environ.get("COPILOT_KEY_LANG", "")
    if override[:2].lower() in STRINGS:
        return override[:2].lower()
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var)
        if not value:
            continue
        code = value.split(".")[0].split("_")[0].lower()
        return code if code in STRINGS else "en"
    return "en"


LANG = language()


def tr(key: str, **fields) -> str:
    text = STRINGS.get(LANG, {}).get(key) or STRINGS["en"][key]
    return text.format(**fields) if fields else text


