]

ACTION_KEYS = ["id", "label", "subtitle", "command", "icon", "app_icon",
               "icon_source", "window_class", "primary"]

ACTIONS_COMMENT = """--- actions ----------------------------------------------------------------
Order = order in the menu = number keys 1-9.

command understands five placeholders:
  @claude-desktop   looks for an installed Claude desktop app,
                    falls back to claude.ai in the browser
  @terminal <cmd>   runs <cmd> in a new terminal window
  @browser <url>    opens <url> in the default application
  @configure        opens the graphical menu editor
  @edit-config      opens this file in the default editor
Anything else runs as an ordinary command line.

icon         : window, terminal, globe, gear, chat, folder, power, pencil,
               sparkle - the symbols the menu draws itself
app_icon     : the application's own icon, as the icon theme calls it; the
               editor and the wheel's edit mode fill this in
icon_source  : "app" or "vector", overruling use_app_icons for this button
window_class : substring of the window's WM_CLASS (used for toggling).
               Find yours with:  wmctrl -lx
primary      : exactly one action should be primary = true - that is the one
               a single key press toggles."""

TEMPLATE_HEADER = """copilot-key - configuration{variant}
Copied to ~/.config/copilot-key/config.toml during installation.
Changes take effect on the next key press - nothing needs restarting.

Everything in here can be clicked together instead:  copilot-key configure"""

FIRST_RUN_HEADER = """copilot-key - configuration
Created from the defaults the first time the key was used.
Edit it here, or click it together:  copilot-key configure
Changes take effect on the next key press - nothing needs restarting."""

USER_HEADER = """copilot-key - configuration
Written by the graphical editor (copilot-key configure).
Editing it by hand stays perfectly fine; the editor rewrites the comments.
Changes take effect on the next key press - nothing needs restarting."""

LANGUAGE_NAMES = {"de": "German"}


def toml_string(value: str) -> str:
    out = str(value).replace("\\", "\\\\").replace('"', '\\"')
    out = out.replace("\r", "\\r").replace("\n", "\\n").replace("\t", "\\t")
    return f'"{out}"'


def toml_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        # Always keep a decimal point: 1.0 must not turn into a TOML integer.
        text = f"{value:.4f}".rstrip("0")
        return text + "0" if text.endswith(".") else text
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(toml_value(item) for item in value) + "]"
    return toml_string(value)


def comment_block(text: str) -> str:
    return "".join(f"# {line}\n" if line else "#\n" for line in text.split("\n"))


def dump_config(cfg: dict, header: str) -> str:
    """Render a complete, commented config.toml."""
    known = [key for key, _comment in GENERAL_COMMENTS]
    general = cfg.get("general", {})

    out = [comment_block(header), "\n[general]\n"]
    first = True
    for key, comment in GENERAL_COMMENTS:
        if key not in general:
            continue
        if not first:
            out.append("\n")
        first = False
        out.append(comment_block(comment))
        out.append(f"{key} = {toml_value(general[key])}\n")
    # Whatever a newer version - or the user - added on top.
    for key, value in general.items():
        if key not in known:
            out.append(f"\n{key} = {toml_value(value)}\n")

    out.append("\n\n")
    out.append(comment_block(ACTIONS_COMMENT))
    for action in cfg.get("actions", []):
        out.append("\n[[actions]]\n")
        for key in ACTION_KEYS:
            if key in action:
                out.append(f"{key} = {toml_value(action[key])}\n")
        for key, value in action.items():
            if key not in ACTION_KEYS:
                out.append(f"{key} = {toml_value(value)}\n")
    return "".join(out)


def normalise_config(general: dict, actions: list) -> dict:
    """Fill the gaps an edited configuration may have left.

    Ids are made unique and exactly one action stays primary, so a single key
    press always has an answer - whoever did the editing.
    """
    result = []
    used: set[str] = set()
    for index, action in enumerate(actions):
        item = dict(action)
        item["label"] = str(item.get("label") or tr("cfg_new_entry"))
        base = slugify(str(item.get("id") or item["label"])) or f"action-{index + 1}"
        ident, suffix = base, 2
        while ident in used:
            ident = f"{base}-{suffix}"
            suffix += 1
        used.add(ident)
        item["id"] = ident
        item["subtitle"] = str(item.get("subtitle", ""))
        item["command"] = str(item.get("command", ""))
        item["icon"] = str(item.get("icon") or icon_for(item))
        item["window_class"] = str(item.get("window_class", ""))
        item["primary"] = bool(item.get("primary"))
        result.append(item)

    primaries = [item for item in result if item["primary"]]
    for item in primaries[1:]:
        item["primary"] = False
    if result and not primaries:
        result[0]["primary"] = True
    return {"general": dict(general), "actions": result}


def save_config(cfg: dict) -> Path:
    """Write the configuration atomically, keeping one backup."""
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file():
        try:
            shutil.copy2(path, path.with_suffix(".toml.bak"))
        except OSError:
            pass
    tmp = path.with_name(path.name + ".new")
    tmp.write_text(dump_config(cfg, USER_HEADER), encoding="utf-8")
    os.replace(tmp, path)   # the key must never read a half-written file
    return path


def slugify(text: str) -> str:
    import unicodedata

    plain = unicodedata.normalize("NFKD", text)
    plain = "".join(ch for ch in plain if not unicodedata.combining(ch))
    return re.sub(r"[^a-z0-9]+", "-", plain.lower()).strip("-")[:40]


# ------------------------------------------------------- desktop entries ---
# Reading the installed applications straight from the XDG desktop files is
# what turns "type a command line" into "pick your app from a list".

FIELD_CODES = re.compile(r"(?<!%)%[fFuUdDnNickvm]")

CATEGORY_ICONS = [
    ("TerminalEmulator", "terminal"),
    ("WebBrowser", "globe"),
    ("FileManager", "folder"),
    ("InstantMessaging", "chat"),
    ("Chat", "chat"),
    ("Email", "chat"),
    ("Settings", "gear"),
    ("Development", "terminal"),
    ("Network", "globe"),
]


class App:
    """One installed application, reduced to what an action needs."""

    __slots__ = ("name", "comment", "command", "window_class", "icon_name",
                 "icon", "terminal", "haystack", "desktop_id")

    def __init__(self, name, comment, command, window_class, icon_name, icon, terminal,
                 desktop_id=""):
        self.desktop_id = desktop_id
        self.name = name
        self.comment = comment
        self.command = command
        self.window_class = window_class
        self.icon_name = icon_name
        self.icon = icon
        self.terminal = terminal
        self.haystack = f"{name} {comment} {command}".lower()


def desktop_dirs() -> list[Path]:
    dirs: list[Path] = []
    home = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    raw = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    candidates = [Path(home)]
    candidates += [Path(part) for part in raw.split(":") if part]
    # Flatpak exports are missing from XDG_DATA_DIRS in some sessions.
    candidates += [Path.home() / ".local/share/flatpak/exports/share",
                   Path("/var/lib/flatpak/exports/share")]
    for base in candidates:
        path = base / "applications"
        if path.is_dir() and path not in dirs:
            dirs.append(path)
    return dirs


def parse_desktop(path: Path) -> dict:
    """Read the [Desktop Entry] group of a .desktop file."""
    data: dict[str, str] = {}
    inside = False
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return data
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            inside = line == "[Desktop Entry]"
            continue
        if not inside or "=" not in line:
            continue
        key, _, value = line.partition("=")
        data[key.strip()] = value.strip()
    return data


def localized(data: dict, key: str) -> str:
    """The translation for the current language, else the base value."""
    return data.get(f"{key}[{LANG}]") or data.get(key, "")


def strip_field_codes(exec_line: str) -> str:
    cleaned = FIELD_CODES.sub("", exec_line).replace("%%", "%")
    return " ".join(cleaned.split())


def guess_icon(data: dict, name: str, command: str, terminal: bool) -> str:
    if terminal:
        return "terminal"
    categories = data.get("Categories", "")
    for needle, icon in CATEGORY_ICONS:
        if needle in categories:
            return icon
    guessed = icon_for({"id": command, "label": name})
    # A plain application opens a window - a better default than "sparkle".
    return "window" if guessed == "sparkle" else guessed


def read_apps() -> list[App]:
    """Every visible, runnable application, deduplicated by desktop id."""
    apps: list[App] = []
    seen: set[str] = set()
    for directory in desktop_dirs():
        try:
            files = sorted(directory.glob("*.desktop"))
        except OSError:
            continue
        for path in files:
            if path.name in seen:
                continue
            seen.add(path.name)
            data = parse_desktop(path)
            if data.get("Type", "Application") != "Application":
                continue
            if data.get("NoDisplay", "").lower() == "true":
                continue
            if data.get("Hidden", "").lower() == "true":
                continue
            exec_line = data.get("Exec", "")
            if not exec_line:
                continue
            try_exec = data.get("TryExec", "")
            if try_exec and not shutil.which(try_exec) and not Path(try_exec).is_file():
                continue
            command = strip_field_codes(exec_line)
            if not command:
                continue
            name = localized(data, "Name") or path.stem
            comment = localized(data, "Comment") or localized(data, "GenericName")
            if comment.strip().lower() == name.strip().lower():
                comment = ""
            terminal = data.get("Terminal", "").lower() == "true"
            window_class = data.get("StartupWMClass", "")
            if not window_class:
                try:
                    window_class = Path(shlex.split(command)[0]).name
                except (ValueError, IndexError):
                    window_class = ""
            apps.append(App(
                name=name,
                comment=comment,
                command=command,
                window_class=window_class,
                icon_name=data.get("Icon", ""),
                icon=guess_icon(data, name, command, terminal),
                terminal=terminal,
                desktop_id=path.name,
            ))
    apps.sort(key=lambda app: app.name.lower())
    return apps


_apps_cache: "list | None" = None
_command_icons: dict = {}
_icon_cache: dict = {}


def installed_apps() -> list:
    """read_apps(), but scanned only once per process."""
    global _apps_cache
    if _apps_cache is None:
        _apps_cache = read_apps()
    return _apps_cache


# Launchers that start other programs: their name says nothing about which
# application is behind a command, so they never count as a match.
GENERIC_LAUNCHERS = {"flatpak", "snap", "env", "sh", "bash", "python3", "python",
                     "gtk-launch", "xdg-open", "exo-open", "gio", "sudo", "pkexec"}

# What the icon theme calls the stand-ins, should a placeholder's own program
# not be found - every freedesktop theme carries these.
FALLBACK_ICONS = {
    "terminal": ("utilities-terminal", "terminal"),
    "browser": ("web-browser", "internet-web-browser"),
    "editor": ("accessories-text-editor", "text-editor"),
    "configure": ("preferences-desktop-keyboard-shortcuts", "preferences-desktop"),
}


def program_names(program: str) -> list[str]:
    """The names a program may go by in a desktop file's Exec line.

    x-terminal-emulator is an alternatives link to gnome-terminal.wrapper, so
    both the name and the real target count, minus the wrapper suffix.
    """
    names = []
    for candidate in (program, os.path.realpath(shutil.which(program) or program)):
        name = Path(candidate).name
        if name.endswith(".wrapper"):
            name = name[:-len(".wrapper")]
        if name and name not in names:
            names.append(name)
    return names


def app_for_program(program: str) -> "App | None":
    names = [n for n in program_names(program) if n not in GENERIC_LAUNCHERS]
    for app in installed_apps():
        try:
            head = Path(shlex.split(app.command)[0]).name
        except (ValueError, IndexError):
            continue
        if head in names and app.icon_name:
            return app
    return None


def app_for_desktop_id(desktop_id: str) -> "App | None":
    desktop_id = desktop_id.strip()
    if not desktop_id:
        return None
    for app in installed_apps():
        if app.desktop_id == desktop_id and app.icon_name:
            return app
    return None


def default_handler(kind: str) -> str:
    """The desktop file of the user's default browser or text editor."""
    if kind == "browser":
        return run_out(["xdg-settings", "get", "default-web-browser"]).strip()
    if kind == "editor":
        return run_out(["xdg-mime", "query", "default", "text/plain"]).strip()
    return ""


def icon_available(name: str) -> bool:
    """Whether a themed icon name (or an icon file) can actually be drawn."""
    if not name:
        return False
    if name.startswith("/"):
        return Path(name).is_file()
    if Gtk is None:
        return True          # nothing to ask - trust the desktop file
    try:
        return bool(Gtk.IconTheme.get_default().has_icon(name))
    except Exception:
        return True


def icon_candidates(command: str, window_class: str = ""):
    """Icon names worth trying for an action, the most specific first.

    Placeholders are followed to the program they really start - Claude's own
    desktop app, the terminal emulator, the default browser, the editor - so
    "the original icon" is the one that program installed.
    """
    command = str(command or "").strip()
    window_class = str(window_class or "").strip().lower()
    fallback = ()

    if command == "@claude-desktop":
        program = chosen_desktop_app()
        app = app_for_program(program) if program else None
        if app:
            yield app.icon_name
        # Without a desktop app the action opens claude.ai in the browser.
        app = app_for_desktop_id(default_handler("browser"))
        if not program and app:
            yield app.icon_name
    elif command.startswith("@terminal "):
        inner = command[len("@terminal "):].strip()
        try:
            head = shlex.split(inner)[0]
        except (ValueError, IndexError):
            head = ""
        app = app_for_program(head) if head else None
        if app:                  # "@terminal htop" has an icon of its own
            yield app.icon_name
        terminal = chosen_terminal()
        app = app_for_program(terminal[0]) if terminal else None
        if app:
            yield app.icon_name
        fallback = FALLBACK_ICONS["terminal"]
    elif command.startswith("@browser "):
        app = app_for_desktop_id(default_handler("browser"))
        if app:
            yield app.icon_name
        fallback = FALLBACK_ICONS["browser"]
    elif command == "@configure":
        app = app_for_desktop_id("copilot-key-config.desktop")
        if app:
            yield app.icon_name
        fallback = FALLBACK_ICONS["configure"]
    elif command == "@edit-config":
        app = app_for_desktop_id(default_handler("editor"))
        if app:
            yield app.icon_name
        fallback = FALLBACK_ICONS["editor"]
    elif command:
        # Exactly the Exec line of a desktop file - how the pickers store it,
        # and the only reliable answer for "flatpak run ..." commands.
        for app in installed_apps():
            if app.command == command and app.icon_name:
                yield app.icon_name
                break
        try:
            head = shlex.split(command)[0]
        except (ValueError, IndexError):
            head = ""
        app = app_for_program(head) if head else None
        if app:
            yield app.icon_name

    if window_class:
        # The window the toggle looks for names its application as well.
        for app in installed_apps():
            if app.icon_name and window_class in app.window_class.lower():
                yield app.icon_name
                break
    yield from fallback


def resolve_app_icon(command: str, window_class: str = "") -> str:
    """The icon the application behind an action installed, "" if none.

    Hand-written entries and the @placeholders carry no icon of their own, so
    the launcher follows them to the program they start and borrows that
    program's icon. Cached per command, since it may ask xdg-settings.
    """
    key = (str(command or "").strip(), str(window_class or "").strip())
    if key in _command_icons:
        return _command_icons[key]
    found = ""
    for name in icon_candidates(*key):
        if icon_available(name):
            found = name
            break
    _command_icons[key] = found
    return found


def original_icon(action: dict) -> str:
    return resolve_app_icon(str(action.get("command", "")),
                            str(action.get("window_class", "")))


def themed_icon_for(action: dict, use_app_icons: bool, fallback: str = "") -> str:
    """Which application icon a button shows - "" means the drawn one.

    icon_source is the per-button answer ("app" or "vector"); without it the
    setting from [general] decides.
    """
    source = str(action.get("icon_source", "")).strip().lower()
    if source == "vector":
        return ""
    if source != "app" and not use_app_icons:
        return ""
    return str(action.get("app_icon", "")).strip() or fallback


def load_app_icon(name: str, size: int):
    """One themed icon (or icon file) as a pixbuf, cached per size."""
    if not name or GdkPixbuf is None:
        return None
    key = (name, size)
    if key in _icon_cache:
        return _icon_cache[key]
    pixbuf = None
    try:
        if name.startswith("/"):
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(name, size, size)
        else:
            pixbuf = Gtk.IconTheme.get_default().load_icon(
                name, size, Gtk.IconLookupFlags.FORCE_SIZE)
    except Exception:
        pixbuf = None
    _icon_cache[key] = pixbuf
    return pixbuf


def draw_app_icon(cr, name: str, size: float, alpha: float = 1.0) -> bool:
    """Paint an application icon centred on the origin; False if there is none."""
    pixbuf = load_app_icon(name, int(max(16, round(size))))
    if pixbuf is None:
        return False
    cr.save()
    Gdk.cairo_set_source_pixbuf(cr, pixbuf,
                                -pixbuf.get_width() / 2.0, -pixbuf.get_height() / 2.0)
    cr.paint_with_alpha(max(0.0, min(1.0, alpha)))
    cr.restore()
    return True


class Choice:
    """One row of the icon search: a drawn icon, or an application's own."""

    __slots__ = ("name", "comment", "icon", "icon_name")

    def __init__(self, name: str, comment: str, icon: str, icon_name: str = "") -> None:
        self.name = name
        self.comment = comment
        self.icon = icon
        self.icon_name = icon_name


def icon_choices(query: str, apps: list) -> list:
    """The drawn icons first, then every application that carries one."""
    out = []
    for name in ICON_NAMES:
        label = tr(f"icon_{name}")
        if not query or query in name or query in label.lower():
            out.append(Choice(label, tr("icon_builtin"), name))
    scored = []
    for app in apps:
        if not app.icon_name:
            continue
        score = match_score(app, query)
        if score >= 0:
            scored.append((score, app.name.lower(), app))
    scored.sort(key=lambda entry: (entry[0], entry[1]))
    out += [Choice(entry[2].name, tr("icon_from_app"), entry[2].icon, entry[2].icon_name)
            for entry in scored]
    return out


def match_score(app: App, query: str) -> int:
    """Lower is better; -1 means "does not match at all"."""
    if not query:
        return 5
    name = app.name.lower()
    words = query.split()
    if not all(word in app.haystack for word in words):
        return -1
    if name.startswith(query):
        return 0
    if any(part.startswith(query) for part in name.split()):
        return 1
    if query in name:
        return 2
    return 3


def open_windows() -> list[tuple[str, str]]:
    """(window class, title) of everything currently on screen."""
    if not have("wmctrl"):
        return []
    found: list[tuple[str, str]] = []
    for line in run_out(["wmctrl", "-lx"]).splitlines():
        parts = line.split(None, 4)
        if len(parts) < 4:
            continue
        wm_class = parts[2]
        title = parts[4] if len(parts) > 4 else ""
        # wmctrl prints "instance.Class"; the class half is the useful one.
        short = wm_class.split(".")[-1] or wm_class
        if short.lower() in ("copilot-key", "copilot-config"):
            continue
        if (short, title) not in found:
            found.append((short, title))
    return found


# ---------------------------------------------------------------- sound ----

class Sound:
    """Fire-and-forget cue playback."""

    def __init__(self, enabled: bool, volume: float) -> None:
        self.enabled = enabled
        self.volume = max(0.0, min(1.0, float(volume)))
        self.player = SELF_DIR / "copilot-sound"

    def play(self, cue: str) -> None:
        if not self.enabled or not self.player.exists():
            return
        env = dict(os.environ, COPILOT_KEY_SOUND_DIR=str(sound_dir()))
        try:
            subprocess.Popen(
                [str(self.player), cue, f"{self.volume:.3f}"],
                env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as exc:
            warn(tr("warn_cue_failed", cue=cue, error=exc))


# --------------------------------------------------------------- windows ---

def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def run_out(args: list[str]) -> str:
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=4).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def find_windows(window_class: str) -> list[str]:
    """Return X11 window ids whose WM_CLASS matches (case-insensitive substring)."""
    if not window_class or not have("wmctrl"):
        return []
    found = []
    for line in run_out(["wmctrl", "-lx"]).splitlines():
        parts = line.split(None, 4)
        if len(parts) < 4:
            continue
        wid, _desktop, wm_class = parts[0], parts[1], parts[2]
        if window_class.lower() in wm_class.lower():
            found.append(wid)
    return found


def active_window() -> str:
    if not have("xdotool"):
        return ""
    wid = run_out(["xdotool", "getactivewindow"]).strip()
    if not wid.isdigit():
        return ""
    return f"0x{int(wid):08x}"


def activate(wid: str) -> bool:
    if have("wmctrl"):
        return subprocess.run(["wmctrl", "-i", "-a", wid]).returncode == 0
    if have("xdotool"):
        return subprocess.run(["xdotool", "windowactivate", str(int(wid, 16))]).returncode == 0
    return False


def minimize(wid: str) -> bool:
    if have("xdotool"):
        return subprocess.run(["xdotool", "windowminimize", str(int(wid, 16))]).returncode == 0
    if have("wmctrl"):
        return subprocess.run(["wmctrl", "-i", "-r", wid, "-b", "add,hidden"]).returncode == 0
    return False


# ------------------------------------------------------- command resolver --

TERMINALS = [
    ("x-terminal-emulator", ["-e"]),
    ("gnome-terminal", ["--"]),
    ("xfce4-terminal", ["-e"]),
    ("konsole", ["-e"]),
    ("tilix", ["-e"]),
    ("kitty", []),
    ("alacritty", ["-e"]),
    ("xterm", ["-e"]),
]

# Known packagings of the (unofficial) Claude desktop app on Linux.
DESKTOP_CANDIDATES = ["claude-desktop", "claude-desktop-app", "Claude", "claude-desktop-bin"]


def chosen_terminal() -> tuple[str, list[str]] | None:
    """The terminal emulator @terminal opens: the first one installed."""
    for term, flag in TERMINALS:
        if have(term):
            return term, flag
    return None


def chosen_desktop_app() -> str:
    """The Claude desktop program @claude-desktop starts, "" if there is none."""
    for candidate in DESKTOP_CANDIDATES:
        if have(candidate):
            return candidate
    return ""


def resolve(command: str) -> list[str] | None:
    """Translate an @placeholder command into an argv list."""
    if command.startswith("@terminal "):
        inner = command[len("@terminal "):].strip()
        terminal = chosen_terminal()
        if terminal is not None:
            term, flag = terminal
            # Keep the terminal open after the program exits.
            return [term, *flag, "bash", "-lc", f"{inner}; exec bash"]
        warn(tr("warn_no_terminal"))
        return None

    if command.startswith("@browser "):
        url = command[len("@browser "):].strip()
        if have("xdg-open"):
            return ["xdg-open", url]
        warn(tr("warn_no_xdg_open"))
        return None

    if command == "@claude-desktop":
        program = chosen_desktop_app()
        if program:
            return [program]
        # Fall back to the web app rather than doing nothing at all.
        if have("xdg-open"):
            warn(tr("warn_no_desktop_app"))
            return ["xdg-open", "https://claude.ai"]
        return None

    if command == "@configure":
        editor = SELF_DIR / "copilot-config"
        if editor.is_file():
            # Started through the interpreter: the file stays runnable even
            # when a copy lost its executable bit.
            return [sys.executable, str(editor)]
        warn(tr("cfg_no_editor", path=editor))
        return None

    if command == "@edit-config":
        path = config_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.is_file():
            write_default_config(path)
        if have("xdg-open"):
            return ["xdg-open", str(path)]
        return None

    return shlex.split(command)


def write_default_config(path: Path) -> None:
    """The shipped defaults, in the language of whoever is logged in."""
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(dump_config(DEFAULT_CONFIG, FIRST_RUN_HEADER), encoding="utf-8")


def ensure_user_config() -> Path:
    """Give every user their own copy of the defaults, once.

    One installation serves the whole machine, but the menu belongs to the
    person using it - so the first press writes the defaults into their own
    ~/.config and everything they change after that stays theirs.
    """
    path = config_path()
    if not path.is_file():
        try:
            write_default_config(path)
        except OSError as exc:
            warn(tr("warn_config_error", path=path, error=exc))
    return path


def launch_resolved(action: dict, sound: Sound) -> None:
    """Start an action without playing the launch cue.

    The radial menu plays that cue the moment the user commits, so the sound
    lines up with the click instead of with the end of the close animation.
    """
    argv = resolve(str(action.get("command", "")))
    if not argv:
        sound.play("error")
        return
    try:
        subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as exc:
        warn(tr("warn_launch_failed", error=exc))
        sound.play("error")


def launch(action: dict, sound: Sound) -> None:
    argv = resolve(str(action.get("command", "")))
    if not argv:
        sound.play("error")
        return
    sound.play("launch")
    launch_resolved(action, sound)


def activate_or_launch(action: dict, sound: Sound) -> None:
    """Toggle behaviour: front if hidden, minimise if already focused."""
    wins = find_windows(str(action.get("window_class", "")))
    if not wins:
        launch(action, sound)
        return
    current = active_window()
    if current and current in wins:
        sound.play("toggle-hide")
        minimize(current)
    else:
        sound.play("toggle-show")
        activate(wins[0])


# ------------------------------------------------------- per-user setup ----
# A system-wide installation is shared by the whole machine, but the shortcut
# lives in each user's own settings. `copilot-key ensure-shortcut` registers
# it, and the autostart entry runs that once per login - so a second user gets
# a working key without anybody touching the system again.

SHORTCUT_NAME = "Copilot key"
SHORTCUT_BINDING = "<Control><Alt><Shift>F12"
CINNAMON_SCHEMA = "org.cinnamon.desktop.keybindings"
CINNAMON_PATH = "/org/cinnamon/desktop/keybindings/custom-keybindings"


def gsettings_set(schema: str, key: str, value: str) -> bool:
    try:
        return subprocess.run(["gsettings", "set", schema, key, value],
                              capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def gsettings_get(schema: str, key: str) -> str:
    return run_out(["gsettings", "get", schema, key]).strip()


def slot_schema(slot: str) -> str:
    return f"{CINNAMON_SCHEMA}.custom-keybinding:{CINNAMON_PATH}/{slot}/"


def ensure_shortcut(command: str = "") -> bool:
    """Bind the Copilot chord to the launcher for the user running this."""
    if not have("gsettings"):
        warn(tr("warn_no_gsettings"))
        return False
    if CINNAMON_SCHEMA not in run_out(["gsettings", "list-schemas"]).split():
        warn(tr("warn_no_cinnamon", binding=SHORTCUT_BINDING))
        return False

    command = command or str(shutil.which(APP) or SELF_DIR / APP)
    raw = gsettings_get(CINNAMON_SCHEMA, "custom-list")
    taken = re.findall(r"'([^']+)'", raw)

    slot = ""
    for index in range(20):                      # reuse our own entry
        candidate = f"custom{index}"
        if gsettings_get(slot_schema(candidate), "name").strip("'\"") == SHORTCUT_NAME:
            slot = candidate
            break
    if not slot:
        for index in range(20):                  # otherwise the first free one
            if f"custom{index}" not in taken:
                slot = f"custom{index}"
                break
    if not slot:
        warn(tr("warn_no_slot"))
        return False

    schema = slot_schema(slot)
    gsettings_set(schema, "name", SHORTCUT_NAME)
    gsettings_set(schema, "command", command)
    gsettings_set(schema, "binding", f"['{SHORTCUT_BINDING}']")
    if slot not in taken:
        taken.append(slot)
        gsettings_set(CINNAMON_SCHEMA, "custom-list",
                      "[" + ", ".join(f"'{entry}'" for entry in taken) + "]")
    return True


# ------------------------------------------------------------ press state --

def note_press(window_ms: int) -> bool:
    """Record this press; return True if it completes a double press."""
    stamp = runtime_dir() / "last-press"
    now = time.monotonic()
    previous = None
    try:
        previous = float(stamp.read_text().strip())
    except (OSError, ValueError):
        pass
    stamp.write_text(f"{now}\n")
    return previous is not None and 0 <= (now - previous) <= window_ms / 1000.0


def running_menu_pid() -> int:
    pidfile = runtime_dir() / "menu.pid"
    try:
        pid = int(pidfile.read_text().strip())
    except (OSError, ValueError):
        return 0
    try:
        os.kill(pid, 0)
    except OSError:
        return 0
    return pid


# ----------------------------------------------------------------- icons ---

def draw_icon(cr, name: str, size: float, rgba) -> None:
    """Draw a vector icon centred on the current origin.

    Everything is drawn from plain Cairo paths - no icon theme, no image
    files, no third-party assets - so the menu looks identical on every
    system and the project stays free of foreign artwork.
    `size` is the icon's bounding box; paths are authored on a 1.0 grid.
    """
    import math

    r, g, b, a = rgba
    cr.set_source_rgba(r, g, b, a)
    s = size
    lw = max(1.4, s * 0.085)
    cr.set_line_width(lw)
    cr.set_line_cap(1)   # round
    cr.set_line_join(1)
    # Whatever drew last - a Pango layout, another icon - may have left the
    # pen somewhere. Without this every arc below would be joined to it.
    cr.new_path()

    if name == "window":
        w, h = s * 0.86, s * 0.68
        cr.rectangle(-w / 2, -h / 2, w, h)
        cr.stroke()
        cr.move_to(-w / 2, -h / 2 + h * 0.28)
        cr.line_to(w / 2, -h / 2 + h * 0.28)
        cr.stroke()
        cr.arc(-w / 2 + lw * 2.1, -h / 2 + h * 0.14, lw * 0.55, 0, 2 * math.pi)
        cr.fill()

    elif name == "terminal":
        w, h = s * 0.86, s * 0.68
        cr.rectangle(-w / 2, -h / 2, w, h)
        cr.stroke()
        cr.move_to(-w * 0.26, -h * 0.12)
        cr.line_to(-w * 0.06, h * 0.05)
        cr.line_to(-w * 0.26, h * 0.22)
        cr.stroke()
        cr.move_to(w * 0.02, h * 0.22)
        cr.line_to(w * 0.28, h * 0.22)
        cr.stroke()

    elif name == "globe":
        rad = s * 0.40
        cr.arc(0, 0, rad, 0, 2 * math.pi)
        cr.stroke()
        cr.move_to(-rad, 0)
        cr.line_to(rad, 0)
        cr.stroke()
        # two meridians as mirrored bezier arcs
        for direction in (1, -1):
            cr.move_to(0, -rad)
            cr.curve_to(direction * rad * 0.78, -rad * 0.45,
                        direction * rad * 0.78, rad * 0.45, 0, rad)
            cr.stroke()

    elif name == "gear":
        outer, inner = s * 0.44, s * 0.30
        teeth = 8
        for i in range(teeth):
            cr.save()
            cr.rotate(i * 2 * math.pi / teeth)
            cr.rectangle(-s * 0.075, -outer - s * 0.04, s * 0.15, s * 0.20)
            cr.fill()
            cr.restore()
        cr.arc(0, 0, (outer + inner) / 2 - s * 0.02, 0, 2 * math.pi)
        cr.set_line_width(s * 0.15)
        cr.stroke()
        cr.set_line_width(lw)

    elif name == "chat":
        w, h = s * 0.82, s * 0.60
        cr.move_to(-w / 2, -h / 2)
        cr.line_to(w / 2, -h / 2)
        cr.line_to(w / 2, h / 2)
        cr.line_to(-w * 0.12, h / 2)
        cr.line_to(-w * 0.30, h / 2 + s * 0.20)
        cr.line_to(-w * 0.30, h / 2)
        cr.line_to(-w / 2, h / 2)
        cr.close_path()
        cr.stroke()

    elif name == "folder":
        w, h = s * 0.84, s * 0.62
        cr.move_to(-w / 2, h / 2)
        cr.line_to(-w / 2, -h / 2)
        cr.line_to(-w * 0.10, -h / 2)
        cr.line_to(-w * 0.02, -h / 2 + s * 0.13)
        cr.line_to(w / 2, -h / 2 + s * 0.13)
        cr.line_to(w / 2, h / 2)
        cr.close_path()
        cr.stroke()

    elif name == "power":
        rad = s * 0.38
        cr.arc(0, s * 0.04, rad, -math.pi * 0.35, math.pi * 1.35)
        cr.stroke()
        cr.move_to(0, -s * 0.44)
        cr.line_to(0, -s * 0.02)
        cr.stroke()

    elif name == "pencil":
        cr.save()
        cr.rotate(-math.pi / 4)
        body, length = s * 0.26, s * 0.74
        cr.rectangle(-body / 2, -length / 2, body, length * 0.72)
        cr.stroke()
        cr.move_to(-body / 2, length * 0.22)
        cr.line_to(0, length / 2 + s * 0.04)
        cr.line_to(body / 2, length * 0.22)
        cr.close_path()
        cr.fill()
        cr.restore()

    elif name == "plus":
        arm = s * 0.32
        cr.move_to(-arm, 0)
        cr.line_to(arm, 0)
        cr.stroke()
        cr.move_to(0, -arm)
        cr.line_to(0, arm)
        cr.stroke()

    elif name == "cross":
        arm = s * 0.28
        cr.move_to(-arm, -arm)
        cr.line_to(arm, arm)
        cr.stroke()
        cr.move_to(arm, -arm)
        cr.line_to(-arm, arm)
        cr.stroke()

    elif name == "image":
        w, h = s * 0.82, s * 0.66
        cr.rectangle(-w / 2, -h / 2, w, h)
        cr.stroke()
        cr.new_path()
        cr.arc(-w * 0.18, -h * 0.16, s * 0.08, 0, 2 * math.pi)
        cr.fill()
        cr.move_to(-w / 2 + lw, h / 2 - lw)
        cr.line_to(-w * 0.04, -h * 0.06)
        cr.line_to(w * 0.16, h * 0.14)
        cr.line_to(w * 0.34, -h * 0.02)
        cr.line_to(w / 2 - lw, h / 2 - lw)
        cr.stroke()

    elif name == "search":
        cr.new_path()
        cr.arc(-s * 0.07, -s * 0.07, s * 0.27, 0, 2 * math.pi)
        cr.stroke()
        cr.move_to(s * 0.13, s * 0.13)
        cr.line_to(s * 0.38, s * 0.38)
        cr.stroke()

    else:  # "sparkle" and anything unknown
        for scale, rot in ((1.0, 0.0), (0.45, math.pi / 4)):
            cr.save()
            cr.rotate(rot)
            tip, waist = s * 0.46 * scale, s * 0.12 * scale
            cr.move_to(0, -tip)
            cr.curve_to(waist, -waist, waist, -waist, tip, 0)
            cr.curve_to(waist, waist, waist, waist, 0, tip)
            cr.curve_to(-waist, waist, -waist, waist, -tip, 0)
            cr.curve_to(-waist, -waist, -waist, -waist, 0, -tip)
            cr.close_path()
            cr.fill()
            cr.restore()


# Every icon draw_icon() knows, in the order the editor offers them.
ICON_NAMES = ("window", "terminal", "globe", "gear", "chat",
              "folder", "power", "pencil", "sparkle")


ICON_GUESS = (
    ("terminal", ("code", "terminal", "shell", "console", "cli")),
    ("globe", ("web", "browser", "http", "url", "online")),
    ("gear", ("config", "setting", "einstell", "konfig", "option")),
    ("window", ("desktop", "app", "fenster", "window")),
    ("folder", ("folder", "ordner", "datei", "file")),
    ("chat", ("chat", "message", "prompt")),
)


def icon_for(action: dict) -> str:
    """Explicit icon wins; otherwise guess from the action's id and label."""
    explicit = str(action.get("icon", "")).strip()
    if explicit:
        return explicit
    haystack = f"{action.get('id', '')} {action.get('label', '')}".lower()
    for icon, needles in ICON_GUESS:
        if any(needle in haystack for needle in needles):
            return icon
    return "sparkle"


# ----------------------------------------------------------------- skins ---
# A skin is a small TOML file: a handful of colours, a button shape and a
# paint style. Everything the overlay draws asks the skin for its colours, so
# a skin changes the whole look without a line of code. Partial skins are fine
# - every key a file omits falls back to the built-in one, exactly like the
# string catalogue. The format is documented in docs/skins.md.

ACCENT = (0.851, 0.467, 0.341)      # warm terracotta - the built-in accent
TEXT_BRIGHT = (0.949, 0.937, 0.922)
TEXT_DIM = (0.640, 0.612, 0.584)

BUILTIN_SKIN = {
    "name": "Terracotta",
    "author": "copilot-key",
    "style": "flat",        # flat | glass | mint
    "shape": "circle",      # circle | rounded
    "colors": {
        "backdrop": "#0B0A09",      # the dimmed desktop behind the wheel
        "button": "#1C1A18",        # an unselected button
        "edge": "#FFFFFF1F",        # its outline (alpha is part of the value)
        "accent": "#D97757",        # selection, badges, the centre
        "text": "#F2EFEB",
        "text_dim": "#A39C94",
    },
    "palette": [],          # one colour per button, cycled; empty = all alike
}


def parse_color(value, fallback=(1.0, 1.0, 1.0, 1.0)):
    """`#RGB`, `#RRGGBB` or `#RRGGBBAA` as an rgba tuple of floats."""
    text = str(value).strip().lstrip("#")
    if len(text) == 3:
        text = "".join(ch * 2 for ch in text)
    if len(text) == 6:
        text += "ff"
    if len(text) != 8:
        return fallback
    try:
        return tuple(int(text[i:i + 2], 16) / 255.0 for i in (0, 2, 4, 6))
    except ValueError:
        return fallback


def shade(rgba, factor: float):
    """Darken (factor < 1) or lighten (factor > 1) without touching alpha."""
    return tuple(min(1.0, rgba[i] * factor) for i in range(3)) + (rgba[3],)


def lighten(rgba, amount: float):
    """Blend towards white; keeps the alpha."""
    return tuple(rgba[i] + (1.0 - rgba[i]) * amount for i in range(3)) + (rgba[3],)


class Skin:
    """The look of the overlay, read from one TOML file."""

    def __init__(self, data: dict, skin_id: str = "terracotta") -> None:
        merged = json.loads(json.dumps(BUILTIN_SKIN))
        for key, value in data.items():
            if key == "colors" and isinstance(value, dict):
                merged["colors"].update(value)
            else:
                merged[key] = value
        colors = merged["colors"]
        self.id = skin_id
        self.name = str(merged.get("name", skin_id))
        self.author = str(merged.get("author", ""))
        self.style = str(merged.get("style", "flat")).lower()
        self.shape = str(merged.get("shape", "circle")).lower()
        self.backdrop = parse_color(colors.get("backdrop"))
        self.button = parse_color(colors.get("button"))
        self.edge = parse_color(colors.get("edge"))
        self.accent = parse_color(colors.get("accent"))
        self.text = parse_color(colors.get("text"))
        self.text_dim = parse_color(colors.get("text_dim"))
        # A palette written below [colors] lands inside that table - a TOML
        # rule everybody trips over once, so both spellings are accepted.
        palette = merged.get("palette") or colors.pop("palette", None) or []
        self.palette = [parse_color(entry) for entry in palette] if isinstance(palette, list) else []

    def item_base(self, index: int):
        """The base colour of button `index` - the palette makes it colourful."""
        if self.palette:
            return self.palette[index % len(self.palette)]
        return self.button


def skin_dirs() -> list[Path]:
    """User skins first, so a copy shadows the one that ships with the app."""
    dirs = [config_path().parent / "skins"]
    dirs += [base / "skins" for base in data_dirs()]
    return [d for d in dict.fromkeys(dirs) if d.is_dir()]


def read_skin_file(path: Path) -> "Skin | None":
    try:
        import tomllib
    except ModuleNotFoundError:   # Python < 3.11
        return None
    try:
        with path.open("rb") as fh:
            data = tomllib.load(fh)
    except Exception as exc:      # a broken skin must never break the menu
        warn(tr("warn_skin_error", path=path, error=exc))
        return None
    return Skin(data, path.stem)


def available_skins() -> "dict[str, Skin]":
    """Every readable skin, keyed by file name, sorted by display name."""
    found: dict[str, Skin] = {"terracotta": Skin(BUILTIN_SKIN, "terracotta")}
    for directory in reversed(skin_dirs()):
        for path in sorted(directory.glob("*.toml")):
            skin = read_skin_file(path)
            if skin is not None:
                found[path.stem] = skin
    return dict(sorted(found.items(), key=lambda item: item[1].name.lower()))


def load_skin(name: str) -> Skin:
    name = str(name or "").strip()
    if not name or name == "terracotta":
        return Skin(BUILTIN_SKIN, "terracotta")
    skins = available_skins()
    if name in skins:
        return skins[name]
    warn(tr("warn_skin_missing", name=name))
    return Skin(BUILTIN_SKIN, "terracotta")


# ------------------------------------------------------------ skin paint ---

def rounded_rect_path(cr, x, y, width, height, radius) -> None:
    import math

    cr.new_path()
    cr.arc(x + width - radius, y + radius, radius, -math.pi / 2, 0)
    cr.arc(x + width - radius, y + height - radius, radius, 0, math.pi / 2)
    cr.arc(x + radius, y + height - radius, radius, math.pi / 2, math.pi)
    cr.arc(x + radius, y + radius, radius, math.pi, 1.5 * math.pi)
    cr.close_path()


def button_path(cr, skin: Skin, x: float, y: float, radius: float) -> None:
    """The outline of one button - a disc, or a rounded square."""
    import math

    cr.new_path()
    if skin.shape == "rounded":
        size = radius * 1.76
        rounded_rect_path(cr, x - size / 2, y - size / 2, size, size, size * 0.26)
    else:
        cr.arc(x, y, radius, 0, 2 * math.pi)


def paint_button(cr, skin: Skin, x: float, y: float, radius: float,
                 index: int = 0, selected: bool = False, alpha: float = 1.0,
                 empty: bool = False) -> None:
    """One wheel button, drawn the way the skin asks for."""
    import cairo

    base = skin.item_base(index)
    if empty:
        base = base[:3] + (base[3] * 0.30,)

    if selected:
        cr.set_source_rgba(*skin.accent[:3], 0.22 * alpha)
        button_path(cr, skin, x, y, radius + 9)
        cr.fill()

    if skin.style == "glass":
        # A lit sphere: shadow underneath, vertical body gradient, and a
        # specular highlight clipped to the button itself.
        cr.set_source_rgba(0, 0, 0, 0.32 * alpha)
        button_path(cr, skin, x, y + radius * 0.12, radius)
        cr.fill()

        body = cairo.LinearGradient(x, y - radius, x, y + radius)
        top, bottom = lighten(base, 0.34), shade(base, 0.52)
        body.add_color_stop_rgba(0.0, *top[:3], top[3] * alpha)
        body.add_color_stop_rgba(1.0, *bottom[:3], bottom[3] * alpha)
        button_path(cr, skin, x, y, radius)
        cr.set_source(body)
        cr.fill_preserve()
        rim = skin.accent if selected else lighten(base, 0.55)
        cr.set_source_rgba(*rim[:3], (0.95 if selected else 0.45) * alpha)
        cr.set_line_width(2.2 if selected else 1.2)
        cr.stroke()

        cr.save()
        button_path(cr, skin, x, y, radius)
        cr.clip()
        gloss = cairo.RadialGradient(x - radius * 0.34, y - radius * 0.52, radius * 0.05,
                                     x - radius * 0.34, y - radius * 0.52, radius * 1.15)
        gloss.add_color_stop_rgba(0.0, 1, 1, 1, 0.42 * alpha)
        gloss.add_color_stop_rgba(1.0, 1, 1, 1, 0.0)
        cr.set_source(gloss)
        cr.paint()
        cr.restore()

    elif skin.style == "mint":
        # Flat with a whisper of a gradient and a solid border - the way the
        # buttons of a Mint desktop are drawn.
        body = cairo.LinearGradient(x, y - radius, x, y + radius)
        top, bottom = lighten(base, 0.10), shade(base, 0.88)
        body.add_color_stop_rgba(0.0, *top[:3], top[3] * alpha)
        body.add_color_stop_rgba(1.0, *bottom[:3], bottom[3] * alpha)
        button_path(cr, skin, x, y, radius)
        cr.set_source(body)
        cr.fill_preserve()
        border = skin.accent if selected else shade(base, 0.62)
        cr.set_source_rgba(*border[:3], (0.95 if selected else 0.9) * alpha)
        cr.set_line_width(2.0 if selected else 1.4)
        cr.stroke()

    else:   # flat
        cr.set_source_rgba(*base[:3], base[3] * 0.97 * alpha)
        button_path(cr, skin, x, y, radius)
        cr.fill_preserve()
        if selected:
            cr.set_source_rgba(*skin.accent[:3], 0.95 * alpha)
            cr.set_line_width(2.0)
        else:
            cr.set_source_rgba(*skin.edge[:3], skin.edge[3] * alpha)
            cr.set_line_width(1.0)
        cr.stroke()


def css_rgba(rgba, alpha=None) -> str:
    """A skin colour as GTK CSS understands it."""
    red, green, blue, own = rgba
    return (f"rgba({int(red * 255)},{int(green * 255)},{int(blue * 255)},"
            f"{own if alpha is None else alpha:.3f})")


def button_icon_rgba(skin: Skin, selected: bool, alpha: float = 1.0):
    """Icon colour on top of a button of this skin."""
    if skin.style in ("glass", "mint"):
        # The button carries the colour, so the icon stays plain.
        return (*skin.text[:3], (1.0 if selected else 0.92) * alpha)
    return (*skin.accent[:3], alpha) if selected else (*skin.text[:3], 0.88 * alpha)


# ------------------------------------------------------------------ menu ---


def cairo_available() -> bool:
    """The radial menu is drawn by hand, which needs the PyGObject/cairo bridge.

    Without python3-gi-cairo the draw handler would raise at the first frame,
    so we check once and fall back to the list menu instead.
    """
    try:
        import cairo  # noqa: F401
        import gi

        gi.require_foreign("cairo")
    except Exception:
        return False
    return True


def show_menu(cfg: dict, sound: "Sound") -> None:
    """Radial overlay menu. Falls back to a plain list on request."""
    style = str(cfg["general"].get("menu_style", "radial")).lower()
    if style != "list" and (not load_gtk() or not cairo_available()):
        warn(tr("warn_no_cairo"))
        style = "list"
    if style == "list":
        show_list_menu(cfg, sound)
    else:
        show_radial_menu(cfg, sound)


# The GTK bits load on demand: a press that only toggles a window never needs
# them, and the list menu works without the cairo bridge.
Gtk = Gdk = GdkPixbuf = GLib = Pango = PangoCairo = cairo = None


def load_gtk() -> bool:
    global Gtk, Gdk, GdkPixbuf, GLib, Pango, PangoCairo, cairo
    if Gtk is not None:
        return True
    try:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("PangoCairo", "1.0")
        from gi.repository import Gdk as _Gdk
        from gi.repository import GdkPixbuf as _GdkPixbuf
        from gi.repository import GLib as _GLib
        from gi.repository import Gtk as _Gtk
        from gi.repository import Pango as _Pango
        from gi.repository import PangoCairo as _PangoCairo
    except (ImportError, ValueError):
        return False
    try:
        import cairo as _cairo
    except ImportError:
        _cairo = None
    Gtk, Gdk, GLib, Pango, PangoCairo = _Gtk, _Gdk, _GLib, _Pango, _PangoCairo
    GdkPixbuf, cairo = _GdkPixbuf, _cairo
    return True


def text_layout(cr, text: str, size: float, bold: bool, max_width=None):
    layout = PangoCairo.create_layout(cr)
    desc = Pango.FontDescription()
    desc.set_family("Sans")
    desc.set_absolute_size(size * Pango.SCALE)
    desc.set_weight(Pango.Weight.BOLD if bold else Pango.Weight.NORMAL)
    layout.set_font_description(desc)
    layout.set_text(text, -1)
    if max_width:
        layout.set_width(int(max_width * Pango.SCALE))
        layout.set_ellipsize(Pango.EllipsizeMode.END)
    return layout


def draw_text(cr, text, x, y, size, bold, rgba, max_width=None, align="center"):
    """Draw one line; `x`/`y` are its centre, or its left edge when left-aligned."""
    layout = text_layout(cr, text, size, bold, max_width)
    if max_width and align == "center":
        layout.set_alignment(Pango.Alignment.CENTER)
    width, height = layout.get_pixel_size()
    cr.save()
    cr.set_source_rgba(*rgba)
    if align == "left":
        cr.move_to(x, y - height / 2)
    else:
        cr.move_to(x - (max_width / 2 if max_width else width / 2), y - height / 2)
    PangoCairo.show_layout(cr, layout)
    cr.restore()
    return width


def ease_out_back(p: float) -> float:
    """Overshoot slightly, so the items feel like they snap into place."""
    c1, c3 = 1.70158, 2.70158
    p = p - 1.0
    return 1.0 + c3 * p * p * p + c1 * p * p


def ease_out_cubic(p: float) -> float:
    return 1.0 - (1.0 - p) ** 3


class RadialMenu:
    """The overlay: a wheel of actions, a centre button and an edit mode.

    Pressing the centre reveals two small tools in the same style: one opens
    the editor window, the other switches the wheel itself into edit mode.
    There the buttons are dragged around, a placeholder adds another one, a
    badge on each button changes its icon, and clicking a button asks which
    application belongs on it - a search panel slides in above the wheel,
    which makes room for it, while the button being filled pulses. Every
    committed change is written straight to the configuration.

    Anything that appears, moves or leaves does so the way the wheel itself
    unrolls: positions are eased towards their target every frame instead of
    jumping, and everything new grows into place.
    """

    OPEN_TIME = 0.34        # seconds until the wheel is fully unrolled
    ITEM_STAGGER = 0.045    # delay between neighbouring items
    CLOSE_TIME = 0.16
    TOOL_TIME = 0.26        # the tools unfolding above the centre
    SEARCH_TIME = 0.30      # the panel sliding in, the wheel making room
    DRAG_SLOP = 7.0         # pixels before a press counts as a drag
    MAX_HITS = 5

    PANEL_PAD = 12.0        # inside the search panel
    PANEL_BOX = 46.0        # the input line
    PANEL_ROW = 42.0        # one result

    def __init__(self, cfg: dict, sound: "Sound") -> None:
        self.cfg = cfg
        self.general = cfg["general"]
        self.actions = cfg["actions"]
        self.sound = sound
        self.skin = load_skin(self.general.get("menu_skin", "terracotta"))
        self.dim = float(self.general.get("dim_opacity", 0.62))
        self.title = str(self.general.get("menu_title", tr("menu_title_fallback")))
        self.use_app_icons = bool(self.general.get("use_app_icons", False))
        self.chosen: dict | None = None

        self.start = time.monotonic()
        self.frame = self.start
        self.closing_at: float | None = None
        self.selected = 0
        self.hover = -1
        self.hover_centre = False
        self.hover_tool = -1
        self.hover_badge = ""           # "remove" or "icon" under the pointer

        self.tools_at: float | None = None
        self.edit = False
        self.edit_at: float | None = None
        self.drag_index = -1
        self.drag_origin = (0.0, 0.0)
        self.drag_pos: tuple[float, float] | None = None
        self.dragging = False

        self.search_slot = -1
        self.search_mode = "app"        # app | icon
        self.search_at: float | None = None
        self.search_text = ""
        self.search_hits: list = []
        self.search_index = 0
        self.apps: list | None = None

        self.size = (1280, 800)         # replaced by the real allocation
        self.press_index = -1
        self.composited = True
        self.area = None
        self.motion: dict = {}          # what each button is doing right now
        self.boxes: list = []           # what was drawn where, for hit testing
        self.resolved: dict = {}        # id(action) -> icon name of its app
        self.backdrop = None            # the desktop, for the frosted panel
        self.frost: dict = {}
        self.hits_at = 0.0
        self.origin = (0, 0)
        self.original = ""              # the original icon of the slot being edited

    # -- time ---------------------------------------------------------------

    def progress(self) -> float:
        now = time.monotonic()
        if self.closing_at is not None:
            return max(0.0, 1.0 - (now - self.closing_at) / self.CLOSE_TIME)
        return min(1.0, (now - self.start) / self.OPEN_TIME)

    def item_progress(self, index: int) -> float:
        now = time.monotonic()
        if self.closing_at is not None:
            return max(0.0, 1.0 - (now - self.closing_at) / self.CLOSE_TIME)
        span = self.OPEN_TIME - self.ITEM_STAGGER * max(1, len(self.actions)) * 0.5
        elapsed = now - self.start - index * self.ITEM_STAGGER
        return max(0.0, min(1.0, elapsed / max(0.05, span)))

    def tools_progress(self) -> float:
        if self.tools_at is None:
            return 0.0
        return min(1.0, (time.monotonic() - self.tools_at) / self.TOOL_TIME)

    def edit_progress(self) -> float:
        if not self.edit or self.edit_at is None:
            return 0.0
        return min(1.0, (time.monotonic() - self.edit_at) / self.TOOL_TIME)

    def search_progress(self) -> float:
        if self.search_at is None:
            return 0.0
        return ease_out_cubic(min(1.0, (time.monotonic() - self.search_at) / self.SEARCH_TIME))

    def pulse(self) -> float:
        """0..1, breathing - the glow of the button waiting for an icon or app."""
        import math

        return 0.5 + 0.5 * math.sin(time.monotonic() * 4.2)

    def tween(self, key, angle: float, dt: float, appearing: bool):
        """Ease one button towards where it belongs, instead of teleporting."""
        import math

        state = self.motion.get(key)
        if state is None:
            # During the opening animation everything is already in flight;
            # anything showing up later grows into place instead.
            state = {"angle": angle, "scale": 0.25 if appearing else 1.0}
            self.motion[key] = state
            return state
        delta = (angle - state["angle"] + math.pi) % (2 * math.pi) - math.pi
        state["angle"] += delta * (1.0 - math.exp(-dt * 11.0))
        state["scale"] += (1.0 - state["scale"]) * (1.0 - math.exp(-dt * 9.0))
        return state

    # -- geometry -----------------------------------------------------------

    def slot_count(self) -> int:
        """Wheel positions: one per action, plus the placeholder in edit mode."""
        return max(1, len(self.actions) + (1 if self.edit else 0))

    def search_panel(self, width: int):
        """(x, y, width, height) of the whole search panel."""
        rows = len(self.search_hits[:self.MAX_HITS])
        height = self.PANEL_PAD * 2 + self.PANEL_BOX
        if rows:
            height += 8 + rows * self.PANEL_ROW
        panel_width = min(660.0, max(400.0, width * 0.48))
        shown = self.search_progress()
        return (width - panel_width) / 2.0, 44.0 - 18.0 * (1.0 - shown), panel_width, height

    def geometry(self, width: int, height: int):
        cx, base_cy = width / 2.0, height / 2.0
        count = self.slot_count()
        radius = min(min(width, height) * 0.26, 320.0)
        radius = max(radius, count * 30.0, 170.0)
        radius = min(radius, min(width, height) * 0.34)
        button = min(52.0, max(34.0, radius * 0.26))

        shown = self.search_progress()
        if shown <= 0.001:
            return cx, base_cy, radius, button, count

        # The panel never sits on the wheel: the wheel moves below it and
        # shrinks as far as it has to, both eased by the same progress.
        _px, py, _pw, ph = self.search_panel(width)
        top = py + ph + 26.0
        room = (height - 52.0) - top
        target_radius = max(90.0, min(radius, room / 2.0 - 44.0))
        target_button = min(46.0, max(24.0, target_radius * 0.26))
        target_cy = top + target_button + target_radius
        return (cx,
                base_cy + (target_cy - base_cy) * shown,
                radius + (target_radius - radius) * shown,
                button + (target_button - button) * shown,
                count)

    def slot_angle(self, slot: int, count: int) -> float:
        import math

        return -math.pi / 2 + slot * (2 * math.pi / count)

    def slot_center(self, slot: int, cx, cy, radius, n, unroll: float = 1.0):
        import math

        angle = self.slot_angle(slot, n) - (1.0 - unroll) * 0.55
        distance = radius * unroll
        return cx + math.cos(angle) * distance, cy + math.sin(angle) * distance

    def order(self) -> list[int]:
        """Action indices in drawing order, honouring a running drag."""
        indices = list(range(len(self.actions)))
        if self.dragging and 0 <= self.drag_index < len(indices):
            indices.remove(self.drag_index)
            indices.insert(self.drop_slot(), self.drag_index)
        return indices

    def drop_slot(self) -> int:
        """Where a dragged button would land, from the angle of the pointer."""
        import math

        if self.drag_pos is None:
            return max(0, self.drag_index)
        width, height = self.size
        cx, cy, _radius, _button, count = self.geometry(width, height)
        x, y = self.drag_pos
        angle = math.atan2(y - cy, x - cx) + math.pi / 2
        step = 2 * math.pi / count
        slot = int(round((angle % (2 * math.pi)) / step)) % count
        return max(0, min(slot, len(self.actions) - 1))

    def tool_centers(self, cx, cy, button):
        """The two small tools, unrolling on a short arc above the centre."""
        opening = ease_out_back(self.tools_progress()) if self.tools_progress() < 1.0 else 1.0
        spread = button * 0.92 * opening
        lift = button * 1.35 * opening
        size = button * 0.42 * max(0.0, min(1.0, self.tools_progress() * 1.6))
        return [
            (cx - spread, cy - lift - button * 0.35, size),
            (cx + spread, cy - lift - button * 0.35, size),
        ]

    # -- the icon on a button -----------------------------------------------

    def themed_icon(self, action: dict) -> str:
        """The application icon a button should show, "" for the vector one."""
        return themed_icon_for(action, self.use_app_icons,
                               self.resolved.get(id(action), ""))

    def resolve_icons(self) -> bool:
        """Look up the real icon of every action - off the first frame.

        Scanning the desktop entries costs a moment, and the wheel should be
        on screen before that happens.
        """
        if self.use_app_icons:
            for action in self.actions:
                if not str(action.get("app_icon", "")).strip():
                    self.resolved[id(action)] = original_icon(action)
            if self.area is not None:
                self.area.queue_draw()
        return False

    # -- painting -----------------------------------------------------------

    def on_draw(self, widget, cr) -> bool:
        import math

        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        self.size = (width, height)
        now = time.monotonic()
        dt = max(0.0, min(0.05, now - self.frame))
        self.frame = now
        fade = self.progress()
        fade_in = ease_out_cubic(min(1.0, fade * 1.6))
        skin = self.skin

        # 1. the dim layer - this is what stops the desktop from bleeding through
        cr.set_operator(cairo.OPERATOR_SOURCE)
        if self.composited:
            cr.set_source_rgba(*skin.backdrop[:3], self.dim * fade_in)
        else:
            cr.set_source_rgb(*skin.backdrop[:3])
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        cx, cy, radius, button, count = self.geometry(width, height)

        # 2. a soft glow behind the wheel, so the centre reads as the focus
        glow = cairo.RadialGradient(cx, cy, radius * 0.15, cx, cy, radius * 1.9)
        glow.add_color_stop_rgba(0.0, *skin.accent[:3], 0.13 * fade_in)
        glow.add_color_stop_rgba(1.0, *skin.accent[:3], 0.0)
        cr.set_source(glow)
        cr.new_path()
        cr.arc(cx, cy, radius * 1.9, 0, 2 * math.pi)
        cr.fill()

        # 3. the title, until the search panel takes the space
        if self.search_slot < 0:
            draw_text(cr, self.title, cx, cy - radius - button - 52, 15, True,
                      (*skin.text[:3], 0.92 * fade_in), max_width=520)

        # 4. connecting ring - an arc that grows with the animation
        ring = ease_out_cubic(min(1.0, fade * 1.2))
        if ring > 0.02:
            cr.set_source_rgba(*skin.text[:3], 0.07 * fade_in)
            cr.set_line_width(1.0)
            cr.new_path()
            cr.arc(cx, cy, radius, -math.pi / 2, -math.pi / 2 + 2 * math.pi * ring)
            cr.stroke()

        self.draw_items(cr, cx, cy, radius, button, count, fade_in, dt)
        self.draw_centre(cr, cx, cy, button, fade_in)
        if self.search_progress() > 0.005:
            self.draw_search(cr, width, fade_in)

        # 5. what the current item does, plus the keys that apply right now
        line = min(cy + radius + button + 74, height - 46)
        if self.search_slot < 0 and not self.edit:
            index = self.hover if self.hover >= 0 else self.selected
            if 0 <= index < len(self.actions):
                subtitle = str(self.actions[index].get("subtitle", ""))
                if subtitle:
                    draw_text(cr, subtitle, cx, line, 13.0, False,
                              (*skin.text[:3], 0.78 * fade_in), max_width=620)
        if self.search_slot >= 0:
            hint = tr("hint_icon") if self.search_mode == "icon" else tr("hint_search")
        elif self.edit:
            hint = tr("hint_edit")
        else:
            hint = tr("hint_radial")
        draw_text(cr, hint, cx, min(cy + radius + button + 104, height - 22), 11.5, False,
                  (*skin.text_dim[:3], 0.65 * fade_in), max_width=820)
        return False

    def draw_items(self, cr, cx, cy, radius, button, count, fade_in, dt) -> None:
        import math

        selected = self.hover if self.hover >= 0 else self.selected
        settled = self.progress() >= 1.0
        self.boxes = []
        alive = set()

        for slot, index in enumerate(self.order()):
            action = self.actions[index]
            key = id(action)
            alive.add(key)
            if self.dragging and index == self.drag_index:
                continue                      # it follows the pointer instead
            unrolling = self.item_progress(index)
            if unrolling <= 0.0:
                continue
            state = self.tween(key, self.slot_angle(slot, count), dt, settled)
            distance = radius * ease_out_back(unrolling)
            x = cx + math.cos(state["angle"]) * distance
            y = cy + math.sin(state["angle"]) * distance
            is_selected = index == selected and not self.dragging
            scale = (0.55 + 0.45 * unrolling) * state["scale"] * (1.06 if is_selected else 1.0)
            size = button * scale
            self.boxes.append(("item", index, x, y, button * 1.22))
            self.draw_item(cr, index, x, y, size,
                           min(1.0, unrolling * 1.5) * fade_in, is_selected)

        if self.edit and not self.dragging:
            alive.add("add")
            state = self.tween("add", self.slot_angle(len(self.actions), count), dt,
                               self.edit_progress() < 1.0 or settled)
            grow = ease_out_back(max(0.05, self.edit_progress()))
            x = cx + math.cos(state["angle"]) * radius * grow
            y = cy + math.sin(state["angle"]) * radius * grow
            self.boxes.append(("add", -1, x, y, button * 1.1))
            self.draw_add_slot(cr, x, y, button * 0.86 * state["scale"] * grow, fade_in,
                               self.hover == len(self.actions))

        if self.dragging and self.drag_pos is not None:
            x, y = self.drag_pos
            self.draw_item(cr, self.drag_index, x, y, button * 1.14, fade_in, True, lifted=True)

        for key in [k for k in self.motion if k not in alive]:
            del self.motion[key]

    def draw_item(self, cr, index: int, x: float, y: float, radius: float,
                  alpha: float, selected: bool, lifted: bool = False) -> None:
        import math

        skin = self.skin
        action = self.actions[index]
        empty = not str(action.get("command", "")).strip()
        filling = index == self.search_slot

        if filling:
            # The button waiting for an application - or for an icon - breathes.
            pulse = self.pulse()
            cr.set_source_rgba(*skin.accent[:3], (0.10 + 0.20 * pulse) * alpha)
            cr.new_path()
            cr.arc(x, y, radius + 10 + 9 * pulse, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgba(*skin.accent[:3], (0.35 + 0.45 * pulse) * alpha)
            cr.set_line_width(2.0)
            cr.new_path()
            cr.arc(x, y, radius + 6, 0, 2 * math.pi)
            cr.stroke()
        elif lifted:
            cr.set_source_rgba(0, 0, 0, 0.35 * alpha)
            cr.new_path()
            cr.arc(x, y + radius * 0.18, radius, 0, 2 * math.pi)
            cr.fill()

        paint_button(cr, skin, x, y, radius, index, selected, alpha, empty)

        if empty:
            cr.set_source_rgba(*skin.text_dim[:3], 0.55 * alpha)
            cr.set_line_width(1.6)
            cr.set_dash([5.0, 5.0])
            button_path(cr, skin, x, y, radius - 1)
            cr.stroke()
            cr.set_dash([])

        cr.save()
        cr.translate(x, y)
        themed = "" if empty else self.themed_icon(action)
        if not (themed and draw_app_icon(cr, themed, radius * 1.05, alpha)):
            draw_icon(cr, "plus" if empty else icon_for(action), radius * 0.92,
                      button_icon_rgba(skin, selected, alpha))
        cr.restore()

        if lifted:
            return

        edit = self.edit_progress()
        number = str(index + 1) if index < 9 else ""
        if edit > 0.01:
            # Editing puts two controls on the corners, so the number moves
            # out of the way instead of fighting them for the same spot.
            if number:
                self.draw_badge(cr, x + radius * 0.74, y + radius * 0.74, number,
                                skin.accent, alpha)
            scale = ease_out_back(min(1.0, edit * 1.2))
            hovered = self.hover == index and self.search_slot < 0
            self.draw_control(cr, x - radius * 0.74, y - radius * 0.74, "cross",
                              alpha * edit, scale, hovered and self.hover_badge == "remove")
            self.draw_control(cr, x + radius * 0.74, y - radius * 0.74, "image",
                              alpha * edit, scale, hovered and self.hover_badge == "icon")
            # They are always on screen in edit mode, so they are always
            # clickable - the hover state only decides how they look.
            self.boxes.append(("remove", index, x - radius * 0.74, y - radius * 0.74, 14.0))
            self.boxes.append(("icon", index, x + radius * 0.74, y - radius * 0.74, 14.0))
        elif number:
            self.draw_badge(cr, x + radius * 0.74, y - radius * 0.74, number, skin.accent, alpha)

        label = str(action.get("label") or "")
        if filling and self.search_mode == "icon" and self.original:
            label = tr("use_original_icon")
        elif empty and not label:
            label = tr("slot_empty")
        draw_text(cr, label, x, y + radius + 17, 12.5, selected or filling,
                  (*skin.text[:3], alpha) if selected or filling
                  else (*skin.text_dim[:3], 0.95 * alpha),
                  max_width=max(190.0, radius * 4.2))

    def draw_control(self, cr, x, y, icon: str, alpha: float, scale: float,
                     hovered: bool) -> None:
        """One of the little badges that edit mode puts on a button."""
        import math

        skin = self.skin
        size = 12.5 * max(0.05, scale) * (1.15 if hovered else 1.0)
        cr.set_source_rgba(*skin.backdrop[:3], 0.95 * alpha)
        cr.new_path()
        cr.arc(x, y, size, 0, 2 * math.pi)
        cr.fill_preserve()
        cr.set_source_rgba(*skin.accent[:3], (0.95 if hovered else 0.6) * alpha)
        cr.set_line_width(1.2)
        cr.stroke()
        cr.save()
        cr.translate(x, y)
        draw_icon(cr, icon, size * 1.05, (*skin.accent[:3], alpha))
        cr.restore()

    def draw_add_slot(self, cr, x, y, radius, alpha, hovered) -> None:
        skin = self.skin
        radius = max(2.0, radius)
        cr.set_source_rgba(*skin.text[:3], (0.10 if hovered else 0.05) * alpha)
        button_path(cr, skin, x, y, radius)
        cr.fill()
        cr.set_source_rgba(*(skin.accent if hovered else skin.text_dim)[:3],
                           (0.9 if hovered else 0.5) * alpha)
        cr.set_line_width(1.8)
        cr.set_dash([6.0, 6.0])
        button_path(cr, skin, x, y, radius)
        cr.stroke()
        cr.set_dash([])
        cr.save()
        cr.translate(x, y)
        draw_icon(cr, "plus", radius * 0.8,
                  (*(skin.accent if hovered else skin.text_dim)[:3], alpha))
        cr.restore()
        draw_text(cr, tr("cfg_add"), x, y + radius + 17, 12.0, hovered,
                  (*(skin.accent if hovered else skin.text_dim)[:3], 0.95 * alpha),
                  max_width=220)

    def draw_badge(self, cr, x, y, text, color, alpha) -> None:
        import math

        cr.set_source_rgba(*self.skin.backdrop[:3], 0.95 * alpha)
        cr.new_path()
        cr.arc(x, y, 10.5, 0, 2 * math.pi)
        cr.fill_preserve()
        cr.set_source_rgba(*color[:3], 0.55 * alpha)
        cr.set_line_width(1.0)
        cr.stroke()
        draw_text(cr, text, x, y, 10.5, True, (*color[:3], alpha))

    def draw_centre(self, cr, cx, cy, button, fade_in) -> None:
        skin = self.skin
        radius = button * 0.82
        active = self.hover_centre or self.tools_at is not None

        cr.set_source_rgba(*shade(skin.button, 0.78)[:3], 0.92 * fade_in)
        button_path(cr, skin, cx, cy, radius)
        cr.fill_preserve()
        cr.set_source_rgba(*skin.accent[:3], (0.55 if active else 0.10) * fade_in)
        cr.set_line_width(2.0 if active else 1.0)
        cr.stroke()
        cr.save()
        cr.translate(cx, cy)
        draw_icon(cr, "sparkle", button * 0.72,
                  (*skin.accent[:3], (1.0 if active else 0.85) * fade_in))
        cr.restore()
        self.boxes.append(("centre", -1, cx, cy, button * 0.9))

        opening = self.tools_progress()
        if opening <= 0.01 or self.dragging:
            return          # a dragged button must not slide behind them
        for i, (tx, ty, size) in enumerate(self.tool_centers(cx, cy, button)):
            if size < 1.0:
                continue
            chosen = i == self.hover_tool or (i == 1 and self.edit)
            paint_button(cr, skin, tx, ty, size, 0, chosen, opening * fade_in)
            cr.save()
            cr.translate(tx, ty)
            draw_icon(cr, ("gear", "pencil")[i], size * 0.95,
                      button_icon_rgba(skin, chosen, opening * fade_in))
            cr.restore()
            self.boxes.append(("tool", i, tx, ty, size * 1.45))
        if self.hover_tool >= 0:
            # Below the centre: above it the tools would sit on the label of
            # whatever button happens to be at the top of the wheel.
            label = (tr("tool_config"), tr("tool_edit"))[self.hover_tool]
            draw_text(cr, label, cx, cy + button * 1.45, 12.0, False,
                      (*skin.text[:3], 0.92 * opening * fade_in), max_width=360)

    def frosted(self, cr, x, y, width, height, alpha) -> bool:
        """The desktop behind the panel, blurred - frosted glass, cheaply.

        Two bilinear scales (far down, then back up) are a box blur that
        GdkPixbuf does in C; blurring by hand in Python would not survive a
        redraw at 60 Hz. The source region is taken from where the panel
        settles, so the slide-in does not invalidate the cache every frame.
        """
        if self.backdrop is None:
            return False
        key = (int(x), int(width), int(height))
        pixbuf = self.frost.get(key)
        if pixbuf is None:
            try:
                available_w = self.backdrop.get_width()
                available_h = self.backdrop.get_height()
                src_x = max(0, min(int(x), available_w - 1))
                src_w = max(1, min(int(width), available_w - src_x))
                src_h = max(1, min(int(height), available_h - 44))
                sub = self.backdrop.new_subpixbuf(src_x, 44, src_w, src_h)
                small = sub.scale_simple(max(2, src_w // 14), max(2, src_h // 14),
                                         GdkPixbuf.InterpType.BILINEAR)
                pixbuf = small.scale_simple(src_w, src_h, GdkPixbuf.InterpType.BILINEAR)
            except Exception:
                pixbuf = False
            self.frost[key] = pixbuf
        if not pixbuf:
            return False
        Gdk.cairo_set_source_pixbuf(cr, pixbuf, x, y)
        cr.paint_with_alpha(alpha)
        return True

    def draw_search(self, cr, width: int, fade_in: float) -> None:
        skin = self.skin
        shown = self.search_progress()
        alpha = shown * fade_in
        x, y, panel_w, panel_h = self.search_panel(width)
        pad = self.PANEL_PAD

        # A shadow, so the panel reads as something lying on top of the wheel.
        cr.set_source_rgba(0, 0, 0, 0.38 * alpha)
        rounded_rect_path(cr, x + 2, y + 7, panel_w, panel_h, 17)
        cr.fill()

        cr.save()
        rounded_rect_path(cr, x, y, panel_w, panel_h, 16)
        cr.clip()
        if self.frosted(cr, x, y, panel_w, panel_h, alpha):
            cr.set_source_rgba(*skin.backdrop[:3], 0.80 * alpha)   # keep the contrast
        else:
            cr.set_source_rgba(*skin.backdrop[:3], 0.99 * alpha)
        cr.paint()
        cr.restore()
        rounded_rect_path(cr, x, y, panel_w, panel_h, 16)
        cr.set_source_rgba(*skin.accent[:3], 0.45 * alpha)
        cr.set_line_width(1.4)
        cr.stroke()

        # the input line
        box_x, box_y = x + pad, y + pad
        box_w, box_h = panel_w - 2 * pad, self.PANEL_BOX
        rounded_rect_path(cr, box_x, box_y, box_w, box_h, box_h / 2)
        cr.set_source_rgba(*lighten(skin.button, 0.10)[:3], 0.96 * alpha)
        cr.fill_preserve()
        cr.set_source_rgba(*skin.accent[:3], 0.55 * alpha)
        cr.set_line_width(1.3)
        cr.stroke()

        cr.save()
        cr.translate(box_x + 24, box_y + box_h / 2)
        draw_icon(cr, "image" if self.search_mode == "icon" else "search", 20,
                  (*skin.accent[:3], 0.9 * alpha))
        cr.restore()

        text_x = box_x + 46
        if self.search_text:
            used = draw_text(cr, self.search_text, text_x, box_y + box_h / 2, 16, False,
                             (*skin.text[:3], alpha), align="left")
        else:
            used = 0
            placeholder = tr("search_icon") if self.search_mode == "icon" \
                else tr("search_placeholder")
            draw_text(cr, placeholder, text_x, box_y + box_h / 2, 16, False,
                      (*skin.text_dim[:3], 0.75 * alpha), align="left")
        if int(time.monotonic() * 2) % 2 == 0:
            cr.set_source_rgba(*skin.accent[:3], alpha)
            cr.rectangle(text_x + used + 3, box_y + box_h / 2 - 11, 2, 22)
            cr.fill()

        # the results, each rolling in a moment after the one above it
        elapsed = time.monotonic() - (self.hits_at or time.monotonic())
        for i, hit in enumerate(self.search_hits[:self.MAX_HITS]):
            row_p = ease_out_cubic(max(0.0, min(1.0, (elapsed - i * 0.045) / 0.20)))
            if row_p <= 0.0:
                continue
            row_alpha = alpha * row_p
            row_y = box_y + box_h + 8 + i * self.PANEL_ROW
            middle = row_y + (self.PANEL_ROW - 6) / 2
            slide = (1.0 - row_p) * 16.0
            chosen = i == self.search_index
            if chosen:
                rounded_rect_path(cr, box_x, row_y, box_w, self.PANEL_ROW - 6, 11)
                cr.set_source_rgba(*skin.accent[:3], 0.26 * row_alpha)
                cr.fill()
            cr.save()
            cr.translate(box_x + 24 + slide, middle)
            themed = getattr(hit, "icon_name", "")
            if not (themed and draw_app_icon(cr, themed, 24, row_alpha)):
                draw_icon(cr, hit.icon, 21,
                          (*(skin.accent if chosen else skin.text)[:3], 0.95 * row_alpha))
            cr.restore()
            draw_text(cr, hit.name, text_x + slide, middle - (8 if hit.comment else 0),
                      13.5, chosen, (*skin.text[:3], row_alpha),
                      max_width=box_w - 70, align="left")
            if hit.comment:
                draw_text(cr, hit.comment, text_x + slide, middle + 9, 11.0, False,
                          (*skin.text_dim[:3], 0.9 * row_alpha),
                          max_width=box_w - 70, align="left")
        if self.search_text and not self.search_hits:
            draw_text(cr, tr("cfg_apps_none"), text_x, box_y + box_h + 26, 13.0, False,
                      (*skin.text_dim[:3], alpha), align="left")

    # -- what is under the pointer ------------------------------------------

    def search_hit_at(self, mx, my, width) -> int:
        x, y, panel_w, _panel_h = self.search_panel(width)
        box_x = x + self.PANEL_PAD
        box_w = panel_w - 2 * self.PANEL_PAD
        top = y + self.PANEL_PAD + self.PANEL_BOX + 8
        if not box_x <= mx <= box_x + box_w:
            return -1
        for i in range(len(self.search_hits[:self.MAX_HITS])):
            row_y = top + i * self.PANEL_ROW
            if row_y <= my <= row_y + self.PANEL_ROW - 6:
                return i
        return -1

    def hit(self, mx: float, my: float):
        """(kind, index) of whatever sits under the pointer.

        Everything is tested against what was actually drawn last frame, so a
        button that is still easing into place still catches the click where
        the eye expects it.
        """
        width, _height = self.size
        if self.search_slot >= 0:
            index = self.search_hit_at(mx, my, width)
            if index >= 0:
                return ("hit", index)
            x, y, panel_w, panel_h = self.search_panel(width)
            if x <= mx <= x + panel_w and y <= my <= y + panel_h:
                return ("panel", -1)
        for kind, index, bx, by, reach in reversed(self.boxes):
            if (mx - bx) ** 2 + (my - by) ** 2 <= reach ** 2:
                return (kind, index)
        return ("none", -1)

    # -- pointer and keyboard -----------------------------------------------

    def on_motion(self, _widget, event) -> bool:
        self.drag_pos = (event.x, event.y)
        if (self.edit and self.press_index >= 0 and not self.dragging
                and self.search_slot < 0):
            dx = event.x - self.drag_origin[0]
            dy = event.y - self.drag_origin[1]
            if dx * dx + dy * dy > self.DRAG_SLOP ** 2:
                self.dragging = True
                self.drag_index = self.press_index
                self.sound.play("drag-lift")

        kind, index = self.hit(event.x, event.y)
        hover, hover_tool, hover_centre, badge = -1, -1, False, ""
        if kind == "tool":
            hover_tool = index
        elif kind == "centre":
            hover_centre = True
        elif kind in ("remove", "icon"):
            hover, badge = index, kind
        elif kind == "item":
            hover = index
        elif kind == "add":
            hover = len(self.actions)
        elif kind == "hit":
            self.search_index = index

        if not self.dragging and hover != self.hover and 0 <= hover < len(self.actions):
            self.selected = hover
            self.sound.play("toggle-show")
        self.hover, self.hover_tool, self.hover_centre = hover, hover_tool, hover_centre
        self.hover_badge = badge
        self.area.queue_draw()
        return True

    def on_press(self, _widget, event) -> bool:
        self.press_index = -1
        kind, index = self.hit(event.x, event.y)
        self.drag_origin = (event.x, event.y)
        self.drag_pos = (event.x, event.y)

        if kind == "hit":
            self.search_index = index
            self.take_hit()
        elif kind == "panel":
            pass
        elif self.search_slot >= 0:
            if kind == "item" and index == self.search_slot and self.search_mode == "icon":
                self.use_original_icon()
            else:
                self.cancel_search()
        elif kind == "tool":
            self.use_tool(index)
        elif kind == "centre":
            self.toggle_tools()
        elif kind == "remove":
            self.remove_slot(index)
        elif kind == "icon":
            self.open_search(index, mode="icon")
        elif kind == "add":
            self.add_slot()
        elif kind == "item":
            if self.edit:
                self.press_index = index        # a click, unless it becomes a drag
                self.selected = index
            else:
                self.begin_close(self.actions[index])
        else:
            self.begin_close(None)
        self.area.queue_draw()
        return True

    def on_release(self, _widget, event) -> bool:
        if self.dragging:
            self.finish_drag()
        elif self.press_index >= 0 and self.edit:
            self.open_search(self.press_index)
        self.press_index = -1
        self.area.queue_draw()
        return True

    def step(self, delta: int) -> None:
        count = self.slot_count() if self.edit else len(self.actions)
        if count <= 0:
            return
        self.hover = -1
        self.selected = (self.selected + delta) % count
        self.area.queue_draw()

    def on_scroll(self, _widget, event) -> bool:
        if self.search_slot >= 0:
            return True
        if event.direction == Gdk.ScrollDirection.UP:
            self.step(-1)
        elif event.direction == Gdk.ScrollDirection.DOWN:
            self.step(1)
        return True

    def on_key(self, _widget, event) -> bool:
        name = Gdk.keyval_name(event.keyval) or ""

        if self.search_slot >= 0:
            if name == "Escape":
                self.cancel_search()
            elif name == "BackSpace":
                self.search_text = self.search_text[:-1]
                self.refresh_hits()
            elif name in ("Return", "KP_Enter"):
                self.take_hit()
            elif name in ("Down", "Tab"):
                if self.search_hits:
                    self.search_index = (self.search_index + 1) % len(self.search_hits)
            elif name in ("Up", "ISO_Left_Tab"):
                if self.search_hits:
                    self.search_index = (self.search_index - 1) % len(self.search_hits)
            elif event.string and event.string.isprintable():
                self.search_text += event.string
                self.refresh_hits()
            self.area.queue_draw()
            return True

        if name == "Escape":
            if self.edit:
                self.leave_edit()
            elif self.tools_at is not None:
                self.toggle_tools()
            else:
                self.begin_close(None)
            self.area.queue_draw()
            return True
        if name in ("Return", "KP_Enter", "space"):
            if self.edit:
                if self.selected >= len(self.actions):
                    self.add_slot()
                else:
                    self.open_search(self.selected)
            elif self.actions:
                self.begin_close(self.actions[self.selected])
            self.area.queue_draw()
            return True
        if name in ("Delete", "BackSpace") and self.edit:
            self.remove_slot(self.selected)
            self.area.queue_draw()
            return True
        if name in ("Right", "Down", "Tab"):
            self.step(1)
            return True
        if name in ("Left", "Up", "ISO_Left_Tab"):
            self.step(-1)
            return True
        if len(name) == 1 and name.isdigit() and name != "0":
            wanted = int(name) - 1
            if self.edit:
                if wanted < self.slot_count():
                    self.selected = wanted
                    self.area.queue_draw()
            elif wanted < len(self.actions):
                self.selected = wanted
                self.begin_close(self.actions[wanted])
            return True
        return False

    # -- editing ------------------------------------------------------------

    def toggle_tools(self) -> None:
        if self.tools_at is None:
            self.tools_at = time.monotonic()
            self.sound.play("toggle-show")
        else:
            if self.edit:
                self.leave_edit()
            else:
                self.sound.play("toggle-hide")
            self.tools_at = None

    def use_tool(self, index: int) -> None:
        if index == 0:                      # the editor window
            launch_resolved({"command": "@configure"}, self.sound)
            self.begin_close(None, cue=False)
            self.sound.play("launch")
        elif self.edit:
            self.leave_edit()
        else:
            self.enter_edit()

    def enter_edit(self) -> None:
        self.edit = True
        self.edit_at = time.monotonic()
        if self.tools_at is None:
            self.tools_at = time.monotonic()
        self.sound.play("menu-open")

    def leave_edit(self) -> None:
        self.cancel_search(cue=False)
        self.edit = False
        self.edit_at = None
        # Placeholders nobody filled never reach the configuration.
        self.actions[:] = [a for a in self.actions if str(a.get("command", "")).strip()]
        self.selected = max(0, min(self.selected, len(self.actions) - 1))
        self.sound.play("menu-dismiss")

    def add_slot(self) -> None:
        self.actions.append({"id": "", "label": "", "subtitle": "", "command": "",
                             "icon": "sparkle", "window_class": "", "primary": False})
        self.selected = len(self.actions) - 1
        self.open_search(self.selected)

    def remove_slot(self, index: int) -> None:
        if not 0 <= index < len(self.actions):
            return
        assigned = [i for i, action in enumerate(self.actions)
                    if str(action.get("command", "")).strip()]
        if assigned == [index]:
            # save() refuses to write an empty menu, so removing the last
            # entry would leave the wheel and the file disagreeing.
            self.sound.play("error")
            return
        if self.search_slot == index:
            self.cancel_search(cue=False)
        del self.actions[index]
        self.selected = max(0, min(self.selected, len(self.actions) - 1))
        self.sound.play("toggle-hide")
        self.save()

    def open_search(self, index: int, mode: str = "app") -> None:
        if not 0 <= index < len(self.actions):
            return
        self.search_slot = index
        self.search_mode = mode
        self.search_at = time.monotonic()
        # Worked out once, up front: the icon search offers it as its first
        # row, and the button only promises it when there is one to give.
        self.original = original_icon(self.actions[index]) if mode == "icon" else ""
        self.search_text = ""
        self.search_index = 0
        if self.apps is None:
            self.apps = installed_apps()
        self.refresh_hits()
        self.sound.play("toggle-show")

    def cancel_search(self, cue: bool = True) -> None:
        if self.search_slot < 0:
            return
        self.close_search()
        if cue:
            self.sound.play("menu-dismiss")

    def close_search(self) -> None:
        self.original = ""
        self.search_slot = -1
        self.search_at = None
        self.search_text = ""
        self.search_hits = []
        self.search_mode = "app"

    def refresh_hits(self) -> None:
        query = self.search_text.strip().lower()
        if self.search_mode == "icon":
            hits = icon_choices(query, self.apps or [])
            label = tr("use_original_icon")
            if self.original and (not query or query in label.lower()
                                  or query in self.original.lower()):
                action = self.actions[self.search_slot]
                hits.insert(0, Choice(label, tr("icon_original_hint"),
                                      icon_for(action), self.original))
            self.search_hits = hits[:self.MAX_HITS]
        else:
            scored = []
            for app in self.apps or []:
                score = match_score(app, query)
                if score >= 0:
                    scored.append((score, app.name.lower(), app))
            scored.sort(key=lambda entry: (entry[0], entry[1]))
            self.search_hits = [entry[2] for entry in scored[:self.MAX_HITS]]
        self.search_index = 0
        self.hits_at = time.monotonic()

    def take_hit(self) -> None:
        if not self.search_hits or self.search_slot < 0:
            return
        hit = self.search_hits[min(self.search_index, len(self.search_hits) - 1)]
        index = self.search_slot
        mode = self.search_mode
        self.close_search()
        action = self.actions[index]

        if mode == "icon":
            themed = getattr(hit, "icon_name", "")
            if themed:
                action["app_icon"] = themed
                action["icon_source"] = "app"
            else:
                action["icon"] = hit.icon
                action["icon_source"] = "vector"
                self.resolved.pop(id(action), None)
        else:
            action.update({
                "id": slugify(hit.name) or action.get("id", ""),
                "label": hit.name,
                "subtitle": hit.comment,
                "command": f"@terminal {hit.command}" if hit.terminal else hit.command,
                "window_class": hit.window_class,
                "icon": hit.icon,
                "app_icon": hit.icon_name,
            })
            self.resolved.pop(id(action), None)
        self.selected = index
        self.sound.play("toggle-show")
        self.save()

    def use_original_icon(self) -> None:
        """Back to the icon the application itself brought along.

        Worked out from the command every time: app_icon may hold whatever
        the icon search put there since, which is exactly what this undoes.
        """
        index = self.search_slot
        action = self.actions[index]
        name = self.original or original_icon(action)
        self.close_search()
        if not name:
            self.sound.play("error")
            return
        action["app_icon"] = name
        action["icon_source"] = "app"
        self.sound.play("toggle-show")
        self.save()

    def finish_drag(self) -> None:
        target = self.drop_slot()
        self.dragging = False
        if 0 <= self.drag_index < len(self.actions) and target != self.drag_index:
            self.actions.insert(target, self.actions.pop(self.drag_index))
            self.selected = target
            self.save()
        self.sound.play("drag-drop")
        self.drag_index = -1

    def save(self) -> None:
        """Write the configuration - edit mode has no save button to forget."""
        keep = [a for a in self.actions if str(a.get("command", "")).strip()]
        if not keep:
            return
        try:
            save_config(normalise_config(self.general, keep))
        except OSError as exc:
            warn(tr("cfg_save_failed", error=exc))
            self.sound.play("error")

    def begin_close(self, action=None, cue: bool = True) -> None:
        if self.closing_at is not None:
            return
        if action is not None:
            self.chosen = action
            self.sound.play("launch")
        elif cue:
            self.sound.play("menu-dismiss")
        self.closing_at = time.monotonic()

    # -- the window ---------------------------------------------------------

    def grab_backdrop(self) -> None:
        """A snapshot of the desktop, for the frosted search panel.

        It has to happen before the overlay is mapped - afterwards the screen
        shows our own dimmed copy of the desktop, wheel included. Only the
        strip the panel can cover is taken, which keeps it a few milliseconds.
        """
        try:
            root = Gdk.get_default_root_window()
            width = min(self.size[0], root.get_width() - self.origin[0])
            height = min(460, self.size[1], root.get_height() - self.origin[1])
            self.backdrop = Gdk.pixbuf_get_from_window(
                root, self.origin[0], self.origin[1], width, height)
        except Exception:
            self.backdrop = None

    def run(self) -> None:
        pidfile = runtime_dir() / "menu.pid"
        pidfile.write_text(f"{os.getpid()}\n")

        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        # A stable title helps window managers (and scripted tests) identify
        # the overlay. set_wmclass() would too, but it is deprecated in GTK 3
        # and GTK derives WM_CLASS from the program name anyway.
        win.set_title("copilot-key")
        win.set_decorated(False)
        win.set_keep_above(True)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
        win.set_app_paintable(True)

        screen = win.get_screen()
        visual = screen.get_rgba_visual()
        self.composited = bool(screen.is_composited()) and visual is not None
        if self.composited:
            win.set_visual(visual)

        display = Gdk.Display.get_default()
        geo = None
        try:
            pointer = display.get_default_seat().get_pointer()
            _screen, px, py = pointer.get_position()
            geo = display.get_monitor_at_point(px, py).get_geometry()
        except Exception:
            monitor = display.get_primary_monitor() if hasattr(display, "get_primary_monitor") else None
            if monitor is not None:
                geo = monitor.get_geometry()
        self.origin = (0, 0)
        if geo is not None:
            win.move(geo.x, geo.y)
            win.set_default_size(geo.width, geo.height)
            win.resize(geo.width, geo.height)
            self.size = (geo.width, geo.height)
            self.origin = (geo.x, geo.y)
        else:
            win.fullscreen()
        self.grab_backdrop()

        self.area = Gtk.DrawingArea()
        self.area.add_events(
            Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.SCROLL_MASK
        )
        win.add(self.area)

        def tick() -> bool:
            if not win.get_realized():
                return False
            self.area.queue_draw()
            if self.closing_at is not None and \
                    time.monotonic() - self.closing_at >= self.CLOSE_TIME:
                win.destroy()
                return False
            return True

        self.area.connect("draw", self.on_draw)
        self.area.connect("motion-notify-event", self.on_motion)
        self.area.connect("button-press-event", self.on_press)
        self.area.connect("button-release-event", self.on_release)
        self.area.connect("scroll-event", self.on_scroll)
        win.connect("key-press-event", self.on_key)
        win.connect("destroy", Gtk.main_quit)

        close_on_focus_loss = bool(self.general.get("close_on_focus_loss", True))
        focus_state = {"had_focus": False}
        opened_at = time.monotonic()

        def on_focus_in(*_args) -> bool:
            focus_state["had_focus"] = True
            return False

        def on_focus_out(*_args) -> bool:
            # Editing means a lot of clicking; a bounced focus must not throw
            # the work away halfway through.
            if (close_on_focus_loss and focus_state["had_focus"] and not self.edit
                    and time.monotonic() - opened_at > 0.6):
                self.begin_close(None)
            return False

        win.connect("focus-in-event", on_focus_in)
        win.connect("focus-out-event", on_focus_out)

        win.show_all()
        win.present_with_time(Gdk.CURRENT_TIME)
        GLib.timeout_add(
            60, lambda: (win.get_window() and win.get_window().focus(Gdk.CURRENT_TIME), False)[1]
        )
        GLib.timeout_add(16, tick)
        if self.use_app_icons:
            GLib.timeout_add(90, self.resolve_icons)

        self.sound.play("menu-open")
        signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
        Gtk.main()

        try:
            pidfile.unlink()
        except OSError:
            pass

        if self.chosen is not None:
            launch_resolved(self.chosen, self.sound)


def show_radial_menu(cfg: dict, sound: "Sound") -> None:
    """Radial overlay menu - the wheel, its centre button and its edit mode."""
    RadialMenu(cfg, sound).run()


def show_list_menu(cfg: dict, sound: "Sound") -> None:
    """Plain vertical list - the fallback for menu_style = "list"."""
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    actions = cfg["actions"]
    pidfile = runtime_dir() / "menu.pid"
    pidfile.write_text(f"{os.getpid()}\n")
    chosen: dict = {}

    # Opaque on purpose: an RGBA visual without a paint handler would let the
    # windows underneath shine through and make the text unreadable. The
    # colours come from the same skin the wheel uses.
    skin = load_skin(cfg["general"].get("menu_skin", "terracotta"))
    css = f"""
    window.copilot-menu {{ background-color: {css_rgba(skin.backdrop, 1.0)};
                           border: 1px solid {css_rgba(skin.text, 0.09)}; }}
    window.copilot-menu list,
    window.copilot-menu listbox,
    window.copilot-menu row {{ background-color: transparent; background-image: none;
                               border: none; }}
    window.copilot-menu row {{ border-radius: 10px; padding: 9px 10px; }}
    window.copilot-menu row:hover {{ background-color: {css_rgba(skin.accent, 0.10)}; }}
    window.copilot-menu row:selected {{
        background-color: {css_rgba(skin.accent, 0.22)};
        box-shadow: inset 2px 0 0 {css_rgba(skin.accent, 1.0)};
    }}
    .cp-title  {{ color: {css_rgba(skin.text, 1.0)}; font-size: 15px; font-weight: 700; }}
    .cp-hint   {{ color: {css_rgba(skin.text_dim, 0.8)}; font-size: 11px; }}
    .cp-label  {{ color: {css_rgba(skin.text, 1.0)}; font-size: 14px; font-weight: 600; }}
    .cp-sub    {{ color: {css_rgba(skin.text_dim, 1.0)}; font-size: 11px; }}
    .cp-index  {{ color: {css_rgba(skin.accent, 1.0)}; font-size: 12px; font-weight: 700; }}
    window.copilot-menu row:selected .cp-label {{ color: #FFFFFF; }}
    """.encode()

    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.get_style_context().add_class("copilot-menu")
    win.set_decorated(False)
    win.set_keep_above(True)
    win.set_skip_taskbar_hint(True)
    win.set_position(Gtk.WindowPosition.CENTER_ALWAYS)
    win.set_default_size(430, -1)
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    outer.set_border_width(16)
    win.add(outer)

    title = Gtk.Label(label=cfg["general"].get("menu_title", tr("menu_title_fallback")), xalign=0.0)
    title.get_style_context().add_class("cp-title")
    outer.pack_start(title, False, False, 0)

    listbox = Gtk.ListBox()
    listbox.set_selection_mode(Gtk.SelectionMode.BROWSE)
    outer.pack_start(listbox, True, True, 4)

    for index, action in enumerate(actions, start=1):
        row = Gtk.ListBoxRow()
        row.action = action  # type: ignore[attr-defined]
        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        idx = Gtk.Label(label=str(index) if index < 10 else " ")
        idx.get_style_context().add_class("cp-index")
        idx.set_size_request(14, -1)
        line.pack_start(idx, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        label = Gtk.Label(label=str(action.get("label", action.get("id", "?"))), xalign=0.0)
        label.get_style_context().add_class("cp-label")
        text.pack_start(label, False, False, 0)
        subtitle = str(action.get("subtitle", ""))
        if subtitle:
            sub = Gtk.Label(label=subtitle, xalign=0.0)
            sub.get_style_context().add_class("cp-sub")
            text.pack_start(sub, False, False, 0)
        line.pack_start(text, True, True, 0)
        row.add(line)
        listbox.add(row)

    hint = Gtk.Label(label=tr("hint_list"), xalign=0.0)
    hint.get_style_context().add_class("cp-hint")
    outer.pack_start(hint, False, False, 0)

    def choose(row) -> None:
        if row is None:
            return
        chosen["action"] = row.action
        win.destroy()

    def on_key(_widget, event) -> bool:
        name = Gdk.keyval_name(event.keyval) or ""
        if name == "Escape":
            win.destroy()
            return True
        if name in ("Return", "KP_Enter", "space"):
            choose(listbox.get_selected_row())
            return True
        if len(name) == 1 and name.isdigit() and name != "0":
            row = listbox.get_row_at_index(int(name) - 1)
            if row is not None:
                choose(row)
            return True
        return False

    close_on_focus_loss = bool(cfg["general"].get("close_on_focus_loss", True))
    opened_at = time.monotonic()
    focus_state = {"had_focus": False}

    def on_focus_in(*_args) -> bool:
        focus_state["had_focus"] = True
        return False

    def on_focus_out(*_args) -> bool:
        if (close_on_focus_loss and focus_state["had_focus"]
                and time.monotonic() - opened_at > 0.6):
            win.destroy()
        return False

    listbox.connect("row-activated", lambda _lb, row: choose(row))
    win.connect("key-press-event", on_key)
    win.connect("destroy", Gtk.main_quit)
    win.connect("focus-in-event", on_focus_in)
    win.connect("focus-out-event", on_focus_out)

    first = listbox.get_row_at_index(0)
    if first is not None:
        listbox.select_row(first)

    win.show_all()
    win.present_with_time(Gdk.CURRENT_TIME)
    GLib.timeout_add(
        60, lambda: (win.get_window() and win.get_window().focus(Gdk.CURRENT_TIME), False)[1]
    )

    sound.play("menu-open")
    signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
    Gtk.main()

    try:
        pidfile.unlink()
    except OSError:
        pass

    if chosen.get("action"):
        launch(chosen["action"], sound)
    else:
        sound.play("menu-dismiss")


# ------------------------------------------------------------------ main ---

def primary_action(cfg: dict) -> dict | None:
    for action in cfg["actions"]:
        if action.get("primary"):
            return action
    return cfg["actions"][0] if cfg["actions"] else None


def main(argv: list[str]) -> int:
    ensure_user_config()        # every user starts from the shipped defaults
    cfg = load_config()
    general = cfg["general"]
    sound = Sound(bool(general.get("sounds", True)), general.get("volume", 0.7))

    mode = "auto"
    if len(argv) > 1:
        mode = argv[1].lstrip("-")

    if mode in ("menu", "toggle", "auto"):
        pass
    elif mode in ("ensure-shortcut", "setup"):
        ensure_user_config()
        return 0 if ensure_shortcut() else 1
    elif mode in ("configure", "config", "settings"):
        launch_resolved({"command": "@configure"}, sound)
        return 0
    elif mode in ("test-sounds",):
        for cue in ("menu-open", "toggle-show", "toggle-hide", "launch",
                    "menu-dismiss", "error", "drag-lift", "drag-drop"):
            print(f"  {cue}")
            sound.play(cue)
            time.sleep(1.0)
        return 0
    else:
        print(__doc__)
        print(tr("usage"))
        return 2

    # An open menu is closed by the next press - the key stays a true toggle.
    pid = running_menu_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        return 0

    double = note_press(int(general.get("double_press_ms", 450)))

    if mode == "menu" or double:
        show_menu(cfg, sound)
        return 0

    action = primary_action(cfg)
    if action is None:
        sound.play("error")
        return 1

    behaviour = str(general.get("single_press", "toggle_or_menu"))
    if mode == "toggle" or behaviour in ("toggle", "toggle_or_menu"):
        if behaviour == "toggle_or_menu" and mode != "toggle" \
                and not find_windows(str(action.get("window_class", ""))):
            show_menu(cfg, sound)
            return 0
        activate_or_launch(action, sound)
        return 0

    show_menu(cfg, sound)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
