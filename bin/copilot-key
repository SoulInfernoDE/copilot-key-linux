            "command": "@edit-config",
            "icon": "gear",
            "window_class": "",
            "primary": False,
        },
    ],
}


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))  # deep copy
    path = config_path()
    if not path.is_file():
        return cfg
    try:
        import tomllib
    except ModuleNotFoundError:  # Python < 3.11
        warn(tr("warn_no_tomllib"))
        return cfg
    try:
        with path.open("rb") as fh:
            user = tomllib.load(fh)
    except Exception as exc:  # a broken config must never break the key
        warn(tr("warn_config_error", path=path, error=exc))
        return cfg
    cfg["general"].update(user.get("general", {}))
    if user.get("actions"):
        cfg["actions"] = user["actions"]
    return cfg


def warn(msg: str) -> None:
    print(f"{APP}: {msg}", file=sys.stderr)


# ---------------------------------------------------------------- sound ----

class Sound:
    """Fire-and-forget cue playback."""

    def __init__(self, enabled: bool, volume: float) -> None:
        self.enabled = enabled
        self.volume = max(0.0, min(1.0, float(volume)))
        self.player = SELF_DIR / "copilot-sound"

    def play(self, cue: str) -> None:
        if not self.enabled or not self.player.exists():
            return
        env = dict(os.environ, COPILOT_KEY_SOUND_DIR=str(sound_dir()))
        try:
            subprocess.Popen(
                [str(self.player), cue, f"{self.volume:.3f}"],
                env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as exc:
            warn(tr("warn_cue_failed", cue=cue, error=exc))


# --------------------------------------------------------------- windows ---

def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def run_out(args: list[str]) -> str:
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=4).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def find_windows(window_class: str) -> list[str]:
    """Return X11 window ids whose WM_CLASS matches (case-insensitive substring)."""
    if not window_class or not have("wmctrl"):
        return []
    found = []
    for line in run_out(["wmctrl", "-lx"]).splitlines():
        parts = line.split(None, 4)
        if len(parts) < 4:
            continue
        wid, _desktop, wm_class = parts[0], parts[1], parts[2]
        if window_class.lower() in wm_class.lower():
            found.append(wid)
    return found


def active_window() -> str:
    if not have("xdotool"):
        return ""
    wid = run_out(["xdotool", "getactivewindow"]).strip()
    if not wid.isdigit():
        return ""
    return f"0x{int(wid):08x}"


def activate(wid: str) -> bool:
    if have("wmctrl"):
        return subprocess.run(["wmctrl", "-i", "-a", wid]).returncode == 0
    if have("xdotool"):
        return subprocess.run(["xdotool", "windowactivate", str(int(wid, 16))]).returncode == 0
    return False


def minimize(wid: str) -> bool:
    if have("xdotool"):
        return subprocess.run(["xdotool", "windowminimize", str(int(wid, 16))]).returncode == 0
    if have("wmctrl"):
        return subprocess.run(["wmctrl", "-i", "-r", wid, "-b", "add,hidden"]).returncode == 0
    return False


# ------------------------------------------------------- command resolver --

TERMINALS = [
    ("x-terminal-emulator", ["-e"]),
    ("gnome-terminal", ["--"]),
    ("xfce4-terminal", ["-e"]),
    ("konsole", ["-e"]),
    ("tilix", ["-e"]),
    ("kitty", []),
    ("alacritty", ["-e"]),
    ("xterm", ["-e"]),
]

# Known packagings of the (unofficial) Claude desktop app on Linux.
DESKTOP_CANDIDATES = ["claude-desktop", "claude-desktop-app", "Claude", "claude-desktop-bin"]


def resolve(command: str) -> list[str] | None:
    """Translate an @placeholder command into an argv list."""
    if command.startswith("@terminal "):
        inner = command[len("@terminal "):].strip()
        for term, flag in TERMINALS:
            if have(term):
                # Keep the terminal open after the program exits.
                return [term, *flag, "bash", "-lc", f"{inner}; exec bash"]
        warn(tr("warn_no_terminal"))
        return None

    if command.startswith("@browser "):
        url = command[len("@browser "):].strip()
        if have("xdg-open"):
            return ["xdg-open", url]
        warn(tr("warn_no_xdg_open"))
        return None

    if command == "@claude-desktop":
        for candidate in DESKTOP_CANDIDATES:
            if have(candidate):
                return [candidate]
        # Fall back to the web app rather than doing nothing at all.
        if have("xdg-open"):
            warn(tr("warn_no_desktop_app"))
            return ["xdg-open", "https://claude.ai"]
        return None

    if command == "@edit-config":
        path = config_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.is_file():
            write_default_config(path)
        if have("xdg-open"):
            return ["xdg-open", str(path)]
        return None

    return shlex.split(command)


def write_default_config(path: Path) -> None:
    template = PROJECT_DIR / "config" / "config.toml"
    path.parent.mkdir(parents=True, exist_ok=True)
    if template.is_file():
        path.write_text(template.read_text())
    else:
        path.write_text("# see project README\n")


def launch_resolved(action: dict, sound: Sound) -> None:
    """Start an action without playing the launch cue.

    The radial menu plays that cue the moment the user commits, so the sound
    lines up with the click instead of with the end of the close animation.
    """
    argv = resolve(str(action.get("command", "")))
    if not argv:
        sound.play("error")
        return
    try:
        subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as exc:
        warn(tr("warn_launch_failed", error=exc))
        sound.play("error")


def launch(action: dict, sound: Sound) -> None:
    argv = resolve(str(action.get("command", "")))
    if not argv:
        sound.play("error")
        return
    sound.play("launch")
    launch_resolved(action, sound)


def activate_or_launch(action: dict, sound: Sound) -> None:
    """Toggle behaviour: front if hidden, minimise if already focused."""
    wins = find_windows(str(action.get("window_class", "")))
    if not wins:
        launch(action, sound)
        return
    current = active_window()
    if current and current in wins:
        sound.play("toggle-hide")
        minimize(current)
    else:
        sound.play("toggle-show")
        activate(wins[0])


# ------------------------------------------------------------ press state --

def note_press(window_ms: int) -> bool:
    """Record this press; return True if it completes a double press."""
    stamp = runtime_dir() / "last-press"
    now = time.monotonic()
    previous = None
    try:
        previous = float(stamp.read_text().strip())
    except (OSError, ValueError):
        pass
    stamp.write_text(f"{now}\n")
    return previous is not None and 0 <= (now - previous) <= window_ms / 1000.0


def running_menu_pid() -> int:
    pidfile = runtime_dir() / "menu.pid"
    try:
        pid = int(pidfile.read_text().strip())
    except (OSError, ValueError):
        return 0
    try:
        os.kill(pid, 0)
    except OSError:
        return 0
    return pid


# ----------------------------------------------------------------- icons ---

def draw_icon(cr, name: str, size: float, rgba) -> None:
    """Draw a vector icon centred on the current origin.

    Everything is drawn from plain Cairo paths - no icon theme, no image
    files, no third-party assets - so the menu looks identical on every
    system and the project stays free of foreign artwork.
    `size` is the icon's bounding box; paths are authored on a 1.0 grid.
    """
    import math

    r, g, b, a = rgba
    cr.set_source_rgba(r, g, b, a)
    s = size
    lw = max(1.4, s * 0.085)
    cr.set_line_width(lw)
    cr.set_line_cap(1)   # round
    cr.set_line_join(1)

    if name == "window":
        w, h = s * 0.86, s * 0.68
        cr.rectangle(-w / 2, -h / 2, w, h)
        cr.stroke()
        cr.move_to(-w / 2, -h / 2 + h * 0.28)
        cr.line_to(w / 2, -h / 2 + h * 0.28)
        cr.stroke()
        cr.arc(-w / 2 + lw * 2.1, -h / 2 + h * 0.14, lw * 0.55, 0, 2 * math.pi)
        cr.fill()

    elif name == "terminal":
        w, h = s * 0.86, s * 0.68
        cr.rectangle(-w / 2, -h / 2, w, h)
        cr.stroke()
        cr.move_to(-w * 0.26, -h * 0.12)
        cr.line_to(-w * 0.06, h * 0.05)
        cr.line_to(-w * 0.26, h * 0.22)
        cr.stroke()
        cr.move_to(w * 0.02, h * 0.22)
        cr.line_to(w * 0.28, h * 0.22)
        cr.stroke()

    elif name == "globe":
        rad = s * 0.40
        cr.arc(0, 0, rad, 0, 2 * math.pi)
        cr.stroke()
        cr.move_to(-rad, 0)
        cr.line_to(rad, 0)
        cr.stroke()
        # two meridians as mirrored bezier arcs
        for direction in (1, -1):
            cr.move_to(0, -rad)
            cr.curve_to(direction * rad * 0.78, -rad * 0.45,
                        direction * rad * 0.78, rad * 0.45, 0, rad)
            cr.stroke()

    elif name == "gear":
        outer, inner = s * 0.44, s * 0.30
        teeth = 8
        for i in range(teeth):
            cr.save()
            cr.rotate(i * 2 * math.pi / teeth)
            cr.rectangle(-s * 0.075, -outer - s * 0.04, s * 0.15, s * 0.20)
            cr.fill()
            cr.restore()
        cr.arc(0, 0, (outer + inner) / 2 - s * 0.02, 0, 2 * math.pi)
        cr.set_line_width(s * 0.15)
        cr.stroke()
        cr.set_line_width(lw)

    elif name == "chat":
        w, h = s * 0.82, s * 0.60
        cr.move_to(-w / 2, -h / 2)
        cr.line_to(w / 2, -h / 2)
        cr.line_to(w / 2, h / 2)
        cr.line_to(-w * 0.12, h / 2)
        cr.line_to(-w * 0.30, h / 2 + s * 0.20)
        cr.line_to(-w * 0.30, h / 2)
        cr.line_to(-w / 2, h / 2)
        cr.close_path()
        cr.stroke()

    elif name == "folder":
        w, h = s * 0.84, s * 0.62
        cr.move_to(-w / 2, h / 2)
        cr.line_to(-w / 2, -h / 2)
        cr.line_to(-w * 0.10, -h / 2)
        cr.line_to(-w * 0.02, -h / 2 + s * 0.13)
        cr.line_to(w / 2, -h / 2 + s * 0.13)
        cr.line_to(w / 2, h / 2)
        cr.close_path()
        cr.stroke()

    elif name == "power":
        rad = s * 0.38
        cr.arc(0, s * 0.04, rad, -math.pi * 0.35, math.pi * 1.35)
        cr.stroke()
        cr.move_to(0, -s * 0.44)
        cr.line_to(0, -s * 0.02)
        cr.stroke()

    else:  # "sparkle" and anything unknown
        for scale, rot in ((1.0, 0.0), (0.45, math.pi / 4)):
            cr.save()
            cr.rotate(rot)
            tip, waist = s * 0.46 * scale, s * 0.12 * scale
            cr.move_to(0, -tip)
            cr.curve_to(waist, -waist, waist, -waist, tip, 0)
            cr.curve_to(waist, waist, waist, waist, 0, tip)
            cr.curve_to(-waist, waist, -waist, waist, -tip, 0)
            cr.curve_to(-waist, -waist, -waist, -waist, 0, -tip)
            cr.close_path()
            cr.fill()
            cr.restore()


ICON_GUESS = (
    ("terminal", ("code", "terminal", "shell", "console", "cli")),
    ("globe", ("web", "browser", "http", "url", "online")),
    ("gear", ("config", "setting", "einstell", "konfig", "option")),
    ("window", ("desktop", "app", "fenster", "window")),
    ("folder", ("folder", "ordner", "datei", "file")),
    ("chat", ("chat", "message", "prompt")),
)


def icon_for(action: dict) -> str:
    """Explicit icon wins; otherwise guess from the action's id and label."""
    explicit = str(action.get("icon", "")).strip()
    if explicit:
        return explicit
    haystack = f"{action.get('id', '')} {action.get('label', '')}".lower()
    for icon, needles in ICON_GUESS:
        if any(needle in haystack for needle in needles):
            return icon
    return "sparkle"


# ------------------------------------------------------------------ menu ---

ACCENT = (0.851, 0.467, 0.341)      # warm terracotta
TEXT_BRIGHT = (0.949, 0.937, 0.922)
TEXT_DIM = (0.640, 0.612, 0.584)


def cairo_available() -> bool:
    """The radial menu is drawn by hand, which needs the PyGObject/cairo bridge.

    Without python3-gi-cairo the draw handler would raise at the first frame,
    so we check once and fall back to the list menu instead.
    """
    try:
        import cairo  # noqa: F401
        import gi

        gi.require_foreign("cairo")
    except Exception:
        return False
    return True


def show_menu(cfg: dict, sound: "Sound") -> None:
    """Radial overlay menu. Falls back to a plain list on request."""
    style = str(cfg["general"].get("menu_style", "radial")).lower()
    if style != "list" and not cairo_available():
        warn(tr("warn_no_cairo"))
        style = "list"
    if style == "list":
        show_list_menu(cfg, sound)
    else:
        show_radial_menu(cfg, sound)


def show_radial_menu(cfg: dict, sound: "Sound") -> None:
    import math

    import cairo
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("PangoCairo", "1.0")
    from gi.repository import Gdk, GLib, Gtk, Pango, PangoCairo

    actions = cfg["actions"]
    if not actions:
        sound.play("error")
        return

    general = cfg["general"]
    dim = float(general.get("dim_opacity", 0.62))
    title_text = str(general.get("menu_title", tr("menu_title_fallback")))

    pidfile = runtime_dir() / "menu.pid"
    pidfile.write_text(f"{os.getpid()}\n")
    chosen: dict = {}

    # --- window: one borderless fullscreen surface on the pointer's monitor --
    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    # A stable title helps window managers (and scripted tests) identify the
    # overlay. set_wmclass() would too, but it is deprecated in GTK 3 and GTK
    # derives WM_CLASS from the program name anyway.
    win.set_title("copilot-key")
    win.set_decorated(False)
    win.set_keep_above(True)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
    win.set_app_paintable(True)

    screen = win.get_screen()
    composited = bool(screen.is_composited())
    visual = screen.get_rgba_visual()
    if visual is not None and composited:
        win.set_visual(visual)

    display = Gdk.Display.get_default()
    geo = None
    try:
        pointer = display.get_default_seat().get_pointer()
        _s, px, py = pointer.get_position()
        monitor = display.get_monitor_at_point(px, py)
        geo = monitor.get_geometry()
    except Exception:
        monitor = display.get_primary_monitor() if hasattr(display, "get_primary_monitor") else None
        if monitor is not None:
            geo = monitor.get_geometry()
    if geo is not None:
        win.move(geo.x, geo.y)
        win.set_default_size(geo.width, geo.height)
        win.resize(geo.width, geo.height)
    else:
        win.fullscreen()

    area = Gtk.DrawingArea()
    area.add_events(
        Gdk.EventMask.POINTER_MOTION_MASK
        | Gdk.EventMask.BUTTON_PRESS_MASK
        | Gdk.EventMask.SCROLL_MASK
    )
    win.add(area)

    # --- animation state ----------------------------------------------------
    OPEN_TIME = 0.34        # seconds until the wheel is fully unrolled
    ITEM_STAGGER = 0.045    # delay between neighbouring items
    CLOSE_TIME = 0.16
    state = {
        "start": time.monotonic(),
        "closing_at": None,
        "selected": 0,
        "hover": -1,
    }

    def ease_out_back(p: float) -> float:
        """Overshoot slightly, so the items feel like they snap into place."""
        c1, c3 = 1.70158, 2.70158
        p = p - 1.0
        return 1.0 + c3 * p * p * p + c1 * p * p

    def ease_out_cubic(p: float) -> float:
        return 1.0 - (1.0 - p) ** 3

    def progress() -> tuple[float, float]:
        """Return (global fade 0..1, direction) for the current frame."""
        now = time.monotonic()
        if state["closing_at"] is not None:
            p = (now - state["closing_at"]) / CLOSE_TIME
            return max(0.0, 1.0 - p), -1.0
        return min(1.0, (now - state["start"]) / OPEN_TIME), 1.0

    def geometry(width: int, height: int):
        n = len(actions)
        cx, cy = width / 2.0, height / 2.0
        # Grow with the screen, but never so far that labels leave the display.
        radius = min(min(width, height) * 0.26, 320.0)
        radius = max(radius, n * 30.0, 170.0)
        radius = min(radius, min(width, height) * 0.34)
        button = min(52.0, max(34.0, radius * 0.26))
        return cx, cy, radius, button, n

    def item_center(index, cx, cy, radius, n, unroll):
        # Start at the top, walk clockwise; items spiral out while unrolling.
        angle = -math.pi / 2 + index * (2 * math.pi / n) - (1.0 - unroll) * 0.55
        r = radius * unroll
        return cx + math.cos(angle) * r, cy + math.sin(angle) * r

    def item_progress(index: int) -> float:
        now = time.monotonic()
        if state["closing_at"] is not None:
            p = (now - state["closing_at"]) / CLOSE_TIME
            return max(0.0, 1.0 - p)
        elapsed = now - state["start"] - index * ITEM_STAGGER
        return max(0.0, min(1.0, elapsed / (OPEN_TIME - ITEM_STAGGER * len(actions) * 0.5)))

    def layout_text(cr, text, size, weight_bold, max_width=None):
        layout = PangoCairo.create_layout(cr)
        desc = Pango.FontDescription()
        desc.set_family("Sans")
        desc.set_absolute_size(size * Pango.SCALE)
        desc.set_weight(Pango.Weight.BOLD if weight_bold else Pango.Weight.NORMAL)
        layout.set_font_description(desc)
        layout.set_text(text, -1)
        if max_width:
            layout.set_width(int(max_width * Pango.SCALE))
            layout.set_ellipsize(Pango.EllipsizeMode.END)
            layout.set_alignment(Pango.Alignment.CENTER)
        return layout

    def draw_centered(cr, text, x, y, size, bold, rgba, max_width=None):
        layout = layout_text(cr, text, size, bold, max_width)
        w, h = layout.get_pixel_size()
        cr.save()
        cr.set_source_rgba(*rgba)
        cr.move_to(x - (max_width / 2 if max_width else w / 2), y - h / 2)
        PangoCairo.show_layout(cr, layout)
        cr.restore()

    def on_draw(widget, cr):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        fade, _direction = progress()
        fade_in = ease_out_cubic(min(1.0, fade * 1.6))

        # 1. the dim layer - this is what stops the desktop from bleeding through
        cr.set_operator(cairo.OPERATOR_SOURCE)
        if composited and visual is not None:
            cr.set_source_rgba(0.043, 0.039, 0.035, dim * fade_in)
        else:
            cr.set_source_rgb(0.043, 0.039, 0.035)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        cx, cy, radius, button, n = geometry(width, height)

        # 2. a soft glow behind the wheel, so the centre reads as the focus
        glow = cairo.RadialGradient(cx, cy, radius * 0.15, cx, cy, radius * 1.9)
        glow.add_color_stop_rgba(0.0, *ACCENT, 0.13 * fade_in)
        glow.add_color_stop_rgba(1.0, *ACCENT, 0.0)
        cr.set_source(glow)
        cr.new_path()
        cr.arc(cx, cy, radius * 1.9, 0, 2 * math.pi)
        cr.fill()

        # 3. title above the wheel
        draw_centered(cr, title_text, cx, cy - radius - button - 52, 15, True,
                      (*TEXT_BRIGHT, 0.92 * fade_in), max_width=520)

        selected = state["hover"] if state["hover"] >= 0 else state["selected"]

        # 4. connecting ring - drawn as an arc that grows with the animation
        ring_p = ease_out_cubic(min(1.0, fade * 1.2))
        if ring_p > 0.02:
            cr.set_source_rgba(1, 1, 1, 0.07 * fade_in)
            cr.set_line_width(1.0)
            cr.new_path()
            cr.arc(cx, cy, radius, -math.pi / 2, -math.pi / 2 + 2 * math.pi * ring_p)
            cr.stroke()

        # 5. the items
        for index, action in enumerate(actions):
            p = item_progress(index)
            if p <= 0.0:
                continue
            unroll = ease_out_back(p)
            alpha = min(1.0, p * 1.5) * fade_in
            x, y = item_center(index, cx, cy, radius, n, unroll)
            is_sel = index == selected
            scale = (0.55 + 0.45 * p) * (1.06 if is_sel else 1.0)
            br = button * scale

            if is_sel:
                cr.set_source_rgba(*ACCENT, 0.22 * alpha)
                cr.new_path()
                cr.arc(x, y, br + 9, 0, 2 * math.pi)
                cr.fill()

            cr.set_source_rgba(0.109, 0.102, 0.094, 0.97 * alpha)
            cr.new_path()
            cr.arc(x, y, br, 0, 2 * math.pi)
            cr.fill_preserve()
            if is_sel:
                cr.set_source_rgba(*ACCENT, 0.95 * alpha)
                cr.set_line_width(2.0)
            else:
                cr.set_source_rgba(1, 1, 1, 0.12 * alpha)
                cr.set_line_width(1.0)
            cr.stroke()

            cr.save()
            cr.translate(x, y)
            icon_rgba = (*ACCENT, alpha) if is_sel else (*TEXT_BRIGHT, 0.88 * alpha)
            draw_icon(cr, icon_for(action), br * 0.92, icon_rgba)
            cr.restore()

            # index badge
            if index < 9:
                bx, by = x + br * 0.74, y - br * 0.74
                cr.set_source_rgba(0.043, 0.039, 0.035, 0.95 * alpha)
                cr.new_path()
                cr.arc(bx, by, 10.5, 0, 2 * math.pi)
                cr.fill_preserve()
                cr.set_source_rgba(*ACCENT, 0.55 * alpha)
                cr.set_line_width(1.0)
                cr.stroke()
                draw_centered(cr, str(index + 1), bx, by, 10.5, True, (*ACCENT, alpha))

            label = str(action.get("label", action.get("id", "?")))
            draw_centered(cr, label, x, y + br + 17, 12.5, is_sel,
                          ((*TEXT_BRIGHT, alpha) if is_sel else (*TEXT_DIM, 0.95 * alpha)),
                          max_width=max(170.0, radius * 1.25))

        # 6. centre medallion
        cr.set_source_rgba(0.086, 0.082, 0.075, 0.92 * fade_in)
        cr.new_path()
        cr.arc(cx, cy, button * 0.82, 0, 2 * math.pi)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.07 * fade_in)
        cr.set_line_width(1.0)
        cr.stroke()
        cr.save()
        cr.translate(cx, cy)
        draw_icon(cr, "sparkle", button * 0.72, (*ACCENT, 0.85 * fade_in))
        cr.restore()

        # 7. subtitle of the current item plus the key hints
        if 0 <= selected < len(actions):
            subtitle = str(actions[selected].get("subtitle", ""))
            if subtitle:
                draw_centered(cr, subtitle, cx, cy + radius + button + 74, 13.0, False,
                              (*TEXT_BRIGHT, 0.78 * fade_in), max_width=620)
        draw_centered(cr, tr("hint_radial"),
                      cx, cy + radius + button + 104, 11.5, False,
                      (*TEXT_DIM, 0.65 * fade_in), max_width=660)
        return False

    def tick():
        if not win.get_realized():
            return False
        area.queue_draw()
        if state["closing_at"] is not None:
            if time.monotonic() - state["closing_at"] >= CLOSE_TIME:
                win.destroy()
                return False
        return True

    def begin_close(action=None) -> None:
        if state["closing_at"] is not None:
            return
        if action is not None:
            chosen["action"] = action
            sound.play("launch")
        else:
            sound.play("menu-dismiss")
        state["closing_at"] = time.monotonic()

    def hit_test(mx, my):
        width = area.get_allocated_width()
        height = area.get_allocated_height()
        cx, cy, radius, button, n = geometry(width, height)
        for index in range(len(actions)):
            p = item_progress(index)
            x, y = item_center(index, cx, cy, radius, n, ease_out_back(p) if p > 0 else 0.0)
            if (mx - x) ** 2 + (my - y) ** 2 <= (button * 1.22) ** 2:
                return index
        return -1

    def on_motion(_widget, event):
        index = hit_test(event.x, event.y)
        if index != state["hover"]:
            state["hover"] = index
            if index >= 0:
                state["selected"] = index
                sound.play("toggle-show")
            area.queue_draw()
        return True

    def on_button(_widget, event):
        index = hit_test(event.x, event.y)
        if index >= 0:
            begin_close(actions[index])
        else:
            begin_close(None)
        return True

    def step_selection(delta: int) -> None:
        state["hover"] = -1
        state["selected"] = (state["selected"] + delta) % len(actions)
        area.queue_draw()

    def on_scroll(_widget, event):
        if event.direction == Gdk.ScrollDirection.UP:
            step_selection(-1)
        elif event.direction == Gdk.ScrollDirection.DOWN:
            step_selection(1)
        return True

    def on_key(_widget, event):
        name = Gdk.keyval_name(event.keyval) or ""
        if name == "Escape":
            begin_close(None)
            return True
        if name in ("Return", "KP_Enter", "space"):
            begin_close(actions[state["selected"]])
            return True
        if name in ("Right", "Down", "Tab"):
            step_selection(1)
            return True
        if name in ("Left", "Up", "ISO_Left_Tab"):
            step_selection(-1)
            return True
        if len(name) == 1 and name.isdigit() and name != "0":
            wanted = int(name) - 1
            if wanted < len(actions):
                state["selected"] = wanted
                begin_close(actions[wanted])
            return True
        return False

    area.connect("draw", on_draw)
    area.connect("motion-notify-event", on_motion)
    area.connect("button-press-event", on_button)
    area.connect("scroll-event", on_scroll)
    win.connect("key-press-event", on_key)
    win.connect("destroy", Gtk.main_quit)

    close_on_focus_loss = bool(general.get("close_on_focus_loss", True))
    focus_state = {"had_focus": False}
    opened_at = time.monotonic()

    def on_focus_in(*_args) -> bool:
        focus_state["had_focus"] = True
        return False

    def on_focus_out(*_args) -> bool:
        if (close_on_focus_loss and focus_state["had_focus"]
                and time.monotonic() - opened_at > 0.6):
            begin_close(None)
        return False

    win.connect("focus-in-event", on_focus_in)
    win.connect("focus-out-event", on_focus_out)

    win.show_all()
    win.present_with_time(Gdk.CURRENT_TIME)
    GLib.timeout_add(
        60, lambda: (win.get_window() and win.get_window().focus(Gdk.CURRENT_TIME), False)[1]
    )
    GLib.timeout_add(16, tick)

    sound.play("menu-open")
    signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
    Gtk.main()

    try:
        pidfile.unlink()
    except OSError:
        pass

    if chosen.get("action"):
        launch_resolved(chosen["action"], sound)


def show_list_menu(cfg: dict, sound: "Sound") -> None:
    """Plain vertical list - the fallback for menu_style = "list"."""
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    actions = cfg["actions"]
    pidfile = runtime_dir() / "menu.pid"
    pidfile.write_text(f"{os.getpid()}\n")
    chosen: dict = {}

    # Opaque on purpose: an RGBA visual without a paint handler would let the
    # windows underneath shine through and make the text unreadable.
    css = b"""
    window.copilot-menu { background-color: #171614; border: 1px solid rgba(255,255,255,0.09); }
    window.copilot-menu list,
    window.copilot-menu listbox,
    window.copilot-menu row { background-color: transparent; background-image: none; border: none; }
    window.copilot-menu row { border-radius: 10px; padding: 9px 10px; }
    window.copilot-menu row:hover { background-color: rgba(217, 119, 87, 0.10); }
    window.copilot-menu row:selected {
        background-color: rgba(217, 119, 87, 0.22);
        box-shadow: inset 2px 0 0 #D97757;
    }
    .cp-title  { color: #F2EFEB; font-size: 15px; font-weight: 700; }
    .cp-hint   { color: #7E7872; font-size: 11px; }
    .cp-label  { color: #F2EFEB; font-size: 14px; font-weight: 600; }
    .cp-sub    { color: #A39C94; font-size: 11px; }
    .cp-index  { color: #D97757; font-size: 12px; font-weight: 700; }
    window.copilot-menu row:selected .cp-label { color: #FFFFFF; }
    window.copilot-menu row:selected .cp-sub   { color: #C8BFB6; }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.get_style_context().add_class("copilot-menu")
    win.set_decorated(False)
    win.set_keep_above(True)
    win.set_skip_taskbar_hint(True)
    win.set_position(Gtk.WindowPosition.CENTER_ALWAYS)
    win.set_default_size(430, -1)
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    outer.set_border_width(16)
    win.add(outer)

    title = Gtk.Label(label=cfg["general"].get("menu_title", tr("menu_title_fallback")), xalign=0.0)
    title.get_style_context().add_class("cp-title")
    outer.pack_start(title, False, False, 0)

    listbox = Gtk.ListBox()
    listbox.set_selection_mode(Gtk.SelectionMode.BROWSE)
    outer.pack_start(listbox, True, True, 4)

    for index, action in enumerate(actions, start=1):
        row = Gtk.ListBoxRow()
        row.action = action  # type: ignore[attr-defined]
        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        idx = Gtk.Label(label=str(index) if index < 10 else " ")
        idx.get_style_context().add_class("cp-index")
        idx.set_size_request(14, -1)
        line.pack_start(idx, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        label = Gtk.Label(label=str(action.get("label", action.get("id", "?"))), xalign=0.0)
        label.get_style_context().add_class("cp-label")
        text.pack_start(label, False, False, 0)
        subtitle = str(action.get("subtitle", ""))
        if subtitle:
            sub = Gtk.Label(label=subtitle, xalign=0.0)
            sub.get_style_context().add_class("cp-sub")
            text.pack_start(sub, False, False, 0)
        line.pack_start(text, True, True, 0)
        row.add(line)
        listbox.add(row)

    hint = Gtk.Label(label=tr("hint_list"), xalign=0.0)
    hint.get_style_context().add_class("cp-hint")
    outer.pack_start(hint, False, False, 0)

    def choose(row) -> None:
        if row is None:
            return
        chosen["action"] = row.action
        win.destroy()

    def on_key(_widget, event) -> bool:
        name = Gdk.keyval_name(event.keyval) or ""
        if name == "Escape":
            win.destroy()
            return True
        if name in ("Return", "KP_Enter", "space"):
            choose(listbox.get_selected_row())
            return True
        if len(name) == 1 and name.isdigit() and name != "0":
            row = listbox.get_row_at_index(int(name) - 1)
            if row is not None:
                choose(row)
            return True
        return False

    close_on_focus_loss = bool(cfg["general"].get("close_on_focus_loss", True))
    opened_at = time.monotonic()
    focus_state = {"had_focus": False}

    def on_focus_in(*_args) -> bool:
        focus_state["had_focus"] = True
        return False

    def on_focus_out(*_args) -> bool:
        if (close_on_focus_loss and focus_state["had_focus"]
                and time.monotonic() - opened_at > 0.6):
            win.destroy()
        return False

    listbox.connect("row-activated", lambda _lb, row: choose(row))
    win.connect("key-press-event", on_key)
    win.connect("destroy", Gtk.main_quit)
    win.connect("focus-in-event", on_focus_in)
    win.connect("focus-out-event", on_focus_out)

    first = listbox.get_row_at_index(0)
    if first is not None:
        listbox.select_row(first)

    win.show_all()
    win.present_with_time(Gdk.CURRENT_TIME)
    GLib.timeout_add(
        60, lambda: (win.get_window() and win.get_window().focus(Gdk.CURRENT_TIME), False)[1]
    )

    sound.play("menu-open")
    signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
    Gtk.main()

    try:
        pidfile.unlink()
    except OSError:
        pass

    if chosen.get("action"):
        launch(chosen["action"], sound)
    else:
        sound.play("menu-dismiss")


# ------------------------------------------------------------------ main ---

def primary_action(cfg: dict) -> dict | None:
    for action in cfg["actions"]:
        if action.get("primary"):
            return action
    return cfg["actions"][0] if cfg["actions"] else None


def main(argv: list[str]) -> int:
    cfg = load_config()
    general = cfg["general"]
    sound = Sound(bool(general.get("sounds", True)), general.get("volume", 0.7))

    mode = "auto"
    if len(argv) > 1:
        mode = argv[1].lstrip("-")

    if mode in ("menu", "toggle", "auto"):
        pass
    elif mode in ("test-sounds",):
        for cue in ("menu-open", "toggle-show", "toggle-hide", "launch", "menu-dismiss", "error"):
            print(f"  {cue}")
            sound.play(cue)
            time.sleep(1.0)
        return 0
    else:
        print(__doc__)
        print(tr("usage"))
        return 2

    # An open menu is closed by the next press - the key stays a true toggle.
    pid = running_menu_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        return 0

    double = note_press(int(general.get("double_press_ms", 450)))

    if mode == "menu" or double:
        show_menu(cfg, sound)
        return 0

    action = primary_action(cfg)
    if action is None:
        sound.play("error")
        return 1

    behaviour = str(general.get("single_press", "toggle_or_menu"))
    if mode == "toggle" or behaviour in ("toggle", "toggle_or_menu"):
        if behaviour == "toggle_or_menu" and mode != "toggle" \
                and not find_windows(str(action.get("window_class", ""))):
            show_menu(cfg, sound)
            return 0
        activate_or_launch(action, sound)
        return 0

    show_menu(cfg, sound)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
